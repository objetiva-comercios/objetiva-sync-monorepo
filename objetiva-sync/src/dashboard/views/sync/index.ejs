<style>
  /* Animación de barra de progreso indeterminada */
  @keyframes progressAnimation {
    0% {
      width: 0%;
      margin-left: 0%;
    }
    50% {
      width: 60%;
      margin-left: 20%;
    }
    100% {
      width: 0%;
      margin-left: 100%;
    }
  }

  .progress-bar-animated {
    animation: progressAnimation 2s ease-in-out infinite;
  }
</style>

<div class="py-6 bg-base-200 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Page Header with Gateway Status -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 mb-6">
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl font-bold mb-2">
          Sincronización Manual
        </h1>
        <p class="text-base-content/60">
          Ejecuta sincronizaciones manuales de datos del ERP al backend remoto
        </p>
      </div>

      <!-- Gateway Connection Status -->
      <div id="gateway-status-container" class="lg:w-80">
        <!-- Loaded via JavaScript -->
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Left Column: Configuration -->
      <div class="lg:col-span-1">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title">
              <i data-lucide="settings" class="w-5 h-5"></i>
              Configuración
            </h3>

            <!-- Query Selection -->
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Queries a sincronizar
                </label>

                <div class="space-y-2" id="query-selection-container">
                  <!-- Cargado dinámicamente -->
                </div>
              </div>

              <!-- Batch Size -->
              <div class="form-control w-full pt-4 border-t">
                <label class="label">
                  <span class="label-text font-medium">Tamaño de lote</span>
                </label>
                <select
                  id="batch-size-select"
                  class="select select-bordered w-full"
                >
                  <option value="50">50 registros</option>
                  <option value="100" selected>100 registros (recomendado)</option>
                  <option value="200">200 registros</option>
                  <option value="500">500 registros</option>
                  <option value="1000">1000 registros</option>
                </select>
                <label class="label">
                  <span class="label-text-alt">Lotes más pequeños son más lentos pero más estables. Lotes grandes son más rápidos pero pueden fallar.</span>
                </label>
              </div>

              <!-- Sync Type -->
              <div class="form-control pt-4 border-t">
                <label class="label cursor-pointer justify-start gap-4">
                  <input
                    type="checkbox"
                    id="full-sync-checkbox"
                    class="checkbox checkbox-primary"
                  />
                  <span class="label-text">Sincronización completa</span>
                </label>
                <label class="label">
                  <span class="label-text-alt">Si no se marca, solo sincronizará datos nuevos/modificados desde la última sincronización</span>
                </label>
              </div>

              <!-- Sync Mode Indicator -->
              <div class="pt-2">
                <div id="sync-mode-indicator" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-base-200">
                  <span id="sync-type-badge" class="badge badge-primary badge-sm">INCREMENTAL</span>
                  <span id="sync-mode-description" class="text-xs opacity-70">Solo registros modificados</span>
                </div>
              </div>

              <!-- Execute Button -->
              <div class="pt-4 border-t">
                <button
                  id="execute-sync-btn"
                  onclick="executeSync()"
                  class="btn btn-primary w-full gap-2"
                >
                  <i data-lucide="play-circle" class="w-4 h-4"></i>
                  Ejecutar Sincronización
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Results -->
      <div class="lg:col-span-2">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title">
              <i data-lucide="activity" class="w-5 h-5"></i>
              Resultados
            </h3>

            <!-- Results Container -->
            <div id="sync-results-container">
              <div class="text-center py-12">
                <i data-lucide="info" class="h-12 w-12 mx-auto mb-3 opacity-60"></i>
                <p class="text-sm opacity-60">Selecciona entidades y haz clic en "Ejecutar Sincronización" para comenzar</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sync State: Per-Entity Timestamps -->
    <div class="mt-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-lg">
            <i data-lucide="clock" class="w-5 h-5"></i>
            Estado por Entidad
          </h3>
          <div id="sync-state-container" class="overflow-x-auto">
            <div class="text-center py-4 text-sm opacity-60">Cargando estado...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sync History -->
    <div class="mt-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-lg">
            <i data-lucide="history" class="w-5 h-5"></i>
            Historial de Sincronizaciones
          </h3>
          <div id="sync-history-container" class="overflow-x-auto">
            <div class="text-center py-4 text-sm opacity-60">Cargando historial...</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  let isSyncing = false;
  let currentEventSource = null;
  let currentSyncLogId = null;
  let isGatewayConnected = false;
  let gatewayCheckInterval = null;
  let statusPollInterval = null; // Track polling interval for cleanup
  let availableQueries = []; // CAMBIO: de availableEntities a availableQueries
  let queryProgress = {}; // CAMBIO: de entityProgress a queryProgress - Almacena progreso de cada query durante sync

  /**
   * Mapeo de entity types a iconos
   */
  const ENTITY_ICONS = {
    'articulo': '📦',
    'comprobante_cabecera': '📄',
    'comprobante_detalle': '📋',
    'comprobante_pago': '💳',
  };

  /**
   * Formatea timestamp ISO a formato dd/mm/yyyy HH:mm:ss
   */
  function formatTimestamp(isoString) {
    if (!isoString) return '-';
    const d = new Date(isoString);
    const pad = (n) => n.toString().padStart(2, '0');
    return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }

  /**
   * Formatea duración en ms a formato legible
   */
  function formatDuration(ms) {
    if (!ms) return '-';
    if (ms < 1000) return `${ms}ms`;
    const seconds = ms / 1000;
    if (seconds < 60) return `${seconds.toFixed(1)}s`;
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = Math.floor(seconds % 60);
    return `${minutes}m ${remainingSeconds}s`;
  }

  /**
   * Actualiza el indicador de modo de sincronización según el checkbox
   */
  function updateSyncModeIndicator() {
    const isFullSync = document.getElementById('full-sync-checkbox').checked;
    const badge = document.getElementById('sync-type-badge');
    const desc = document.getElementById('sync-mode-description');
    if (!badge || !desc) return;

    if (isFullSync) {
      badge.textContent = 'COMPLETA';
      badge.className = 'badge badge-warning badge-sm';
      desc.textContent = 'Todos los registros desde el principio';
    } else {
      badge.textContent = 'INCREMENTAL';
      badge.className = 'badge badge-primary badge-sm';
      desc.textContent = 'Solo registros modificados';
    }
  }

  /**
   * Carga el estado de sincronización por entidad
   */
  async function loadSyncState() {
    try {
      const response = await fetch('/api/sync/sync-state');
      const result = await response.json();
      const container = document.getElementById('sync-state-container');
      if (!container) return;

      if (!result.success || !result.data || result.data.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-sm opacity-60">No hay datos de sincronización</div>';
        return;
      }

      const html = `
        <table class="table table-sm w-full">
          <thead>
            <tr>
              <th>Entidad</th>
              <th>Query</th>
              <th>Ultimo Sync</th>
              <th>Registros</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            ${result.data.map(item => {
              const icon = ENTITY_ICONS[item.entityType] || '📋';
              const statusBadge = item.status === 'running' ? 'badge-warning' :
                                  item.status === 'error' ? 'badge-error' : 'badge-info';
              const lastSync = item.lastSyncAt ? formatTimestamp(item.lastSyncAt) : '<i>Sin sincronizar</i>';
              const records = item.lastSyncCount || 0;
              return `
                <tr>
                  <td>${icon} ${escapeHtml(item.entityType)}</td>
                  <td class="text-xs">${escapeHtml(item.queryName || '-')}</td>
                  <td class="text-xs">${lastSync}</td>
                  <td class="text-xs">${records}</td>
                  <td><span class="badge ${statusBadge} badge-sm">${escapeHtml(item.status || 'idle')}</span></td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      `;
      container.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    } catch (error) {
      console.error('Error loading sync state:', error);
      const container = document.getElementById('sync-state-container');
      if (container) {
        container.innerHTML = '<div class="text-center py-4 text-sm text-red-600">Error al cargar estado</div>';
      }
    }
  }

  /**
   * Carga el historial de sincronizaciones
   */
  async function loadSyncHistory() {
    try {
      const response = await fetch('/api/sync/history?limit=15');
      const result = await response.json();
      const container = document.getElementById('sync-history-container');
      if (!container) return;

      if (!result.success || !result.data || result.data.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-sm opacity-60">No hay historial de sincronizaciones</div>';
        return;
      }

      const html = `
        <table class="table table-sm w-full">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Query</th>
              <th>Tipo</th>
              <th>Obtenidos</th>
              <th>Enviados</th>
              <th>Fallidos</th>
              <th>Duracion</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            ${result.data.map(entry => {
              const syncTypeBadge = entry.syncType === 'full' ? 'badge-warning' :
                                    entry.syncType === 'manual' ? 'badge-info' : 'badge-primary';
              const syncTypeLabel = entry.syncType === 'full' ? 'COMPLETA' :
                                    entry.syncType === 'manual' ? 'MANUAL' : 'INCREMENTAL';
              const statusBadge = entry.status === 'success' ? 'badge-success' :
                                  entry.status === 'failed' ? 'badge-error' :
                                  entry.status === 'partial' ? 'badge-warning' : 'badge-ghost';
              return `
                <tr>
                  <td class="text-xs">${formatTimestamp(entry.createdAt)}</td>
                  <td class="text-xs">${escapeHtml(entry.queryName || '-')}</td>
                  <td><span class="badge ${syncTypeBadge} badge-sm">${syncTypeLabel}</span></td>
                  <td class="text-xs">${entry.recordsFetched || 0}</td>
                  <td class="text-xs">${entry.recordsSent || 0}</td>
                  <td class="text-xs">${entry.recordsFailed || 0}</td>
                  <td class="text-xs">${formatDuration(entry.durationMs)}</td>
                  <td><span class="badge ${statusBadge} badge-sm">${escapeHtml(entry.status || 'unknown')}</span></td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      `;
      container.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    } catch (error) {
      console.error('Error loading sync history:', error);
      const container = document.getElementById('sync-history-container');
      if (container) {
        container.innerHTML = '<div class="text-center py-4 text-sm text-red-600">Error al cargar historial</div>';
      }
    }
  }

  /**
   * Carga las queries disponibles desde el API
   */
  async function loadAvailableQueries() {
    try {
      const response = await fetch('/api/sync/available-queries');
      const result = await response.json();

      if (result.success) {
        availableQueries = result.queries;
        renderQueryCheckboxes();
      } else {
        console.error('Error loading available queries:', result);
      }
    } catch (error) {
      console.error('Error loading available queries:', error);
    }
  }

  /**
   * Renderiza los checkboxes de queries ordenadas por displayOrder
   */
  function renderQueryCheckboxes() {
    const container = document.getElementById('query-selection-container');
    if (!container) return;

    container.innerHTML = availableQueries
      .map((query) => {
        const icon = ENTITY_ICONS[query.entityType] || '📋';
        const isAvailable = query.available;
        const checkboxId = `query-${query.id}`;
        const progressId = `progress-${query.id}`;

        // Obtener progreso si existe
        const progress = queryProgress[query.id];
        const progressText = progress
          ? ` <span class="text-xs font-semibold" id="${progressId}">${progress.current}/${progress.total}</span>`
          : `<span class="text-xs font-semibold" id="${progressId}"></span>`;

        return `
          <label class="flex items-center gap-3 ${!isAvailable ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}">
            <input
              type="checkbox"
              id="${checkboxId}"
              value="${query.id}"
              class="query-checkbox checkbox checkbox-primary checkbox-sm"
              ${!isAvailable ? 'disabled' : ''}
              onchange="updateExecuteButtonState()"
            />
            <span class="text-sm">
              ${icon} ${escapeHtml(query.name)}
              ${progressText}
            </span>
          </label>
        `;
      })
      .join('');

    // Actualizar estado inicial del botón
    updateExecuteButtonState();
  }

  /**
   * Actualiza el estado del botón de ejecutar sincronización
   * basado en si hay queries seleccionadas
   */
  function updateExecuteButtonState() {
    const executeBtn = document.getElementById('execute-sync-btn');
    if (!executeBtn) return;

    // Si está sincronizando, no cambiar estado
    if (isSyncing) return;

    const selectedQueries = document.querySelectorAll('.query-checkbox:checked');
    const hasSelection = selectedQueries.length > 0;

    // Considerar también el estado del gateway
    if (!hasSelection) {
      executeBtn.disabled = true;
      executeBtn.title = 'Debes seleccionar al menos una query';
    } else if (!isGatewayConnected) {
      executeBtn.disabled = true;
      executeBtn.title = 'Gateway no disponible';
    } else {
      executeBtn.disabled = false;
      executeBtn.title = '';
    }
  }

  /**
   * Actualiza el progreso de una query en el checkbox
   */
  function updateQueryProgress(queryId, current, total) {
    queryProgress[queryId] = { current, total };

    const progressSpan = document.getElementById(`progress-${queryId}`);
    if (progressSpan) {
      progressSpan.textContent = `${current}/${total}`;
    }
  }

  /**
   * Limpia el progreso de todas las queries
   */
  function clearQueryProgress() {
    queryProgress = {};

    // Limpiar todos los spans de progreso
    availableQueries.forEach((query) => {
      const progressSpan = document.getElementById(`progress-${query.id}`);
      if (progressSpan) {
        progressSpan.textContent = '';
      }
    });
  }

  /**
   * Chequea la conexión con objetiva-sync-gateway
   */
  async function checkGatewayConnection() {
    try {
      const response = await fetch('/api/sync/gateway-health');
      const result = await response.json();

      isGatewayConnected = result.connected;
      updateGatewayStatus(result);
      updateSyncButtonState();
    } catch (error) {
      console.error('Error checking gateway connection:', error);
      isGatewayConnected = false;
      updateGatewayStatus({
        connected: false,
        message: 'Error al verificar conexión',
      });
      updateSyncButtonState();
    }
  }

  /**
   * Actualiza el UI del estado de conexión del gateway
   */
  function updateGatewayStatus(result) {
    const container = document.getElementById('gateway-status-container');

    if (!container) return;

    const statusClass = result.connected
      ? 'bg-green-50 border-green-400'
      : 'bg-red-50 border-red-400';

    const iconName = result.connected
      ? 'check-circle'
      : 'x-circle';

    const iconColor = result.connected
      ? 'text-green-400'
      : 'text-red-400';

    const textColor = result.connected
      ? 'text-green-800'
      : 'text-red-800';

    const descColor = result.connected
      ? 'text-green-700'
      : 'text-red-700';

    const title = result.connected
      ? 'Gateway conectado'
      : 'Gateway no disponible';

    const alertClass = result.connected ? 'alert-success' : 'alert-error';

    const html = `
      <div class="alert ${alertClass} py-3 shadow-lg">
        <i data-lucide="${iconName}" class="h-5 w-5"></i>
        <div class="flex-1">
          <h3 class="font-semibold text-sm">${title}</h3>
          <p class="text-xs mt-0.5 opacity-80">${escapeHtml(result.message)}</p>
        </div>
      </div>
    `;

    container.innerHTML = html;
    if (window.lucide) lucide.createIcons();
  }

  /**
   * Actualiza el estado del botón de sincronización según conexión del gateway
   */
  function updateSyncButtonState() {
    // Delegar a la función principal que considera todo
    updateExecuteButtonState();
  }

  /**
   * Inicia el chequeo periódico de conexión al gateway
   */
  function startGatewayCheck() {
    // Chequeo inmediato
    checkGatewayConnection();

    // Chequeo cada 30 segundos
    if (gatewayCheckInterval) {
      clearInterval(gatewayCheckInterval);
    }

    gatewayCheckInterval = setInterval(() => {
      checkGatewayConnection();
    }, 30000); // 30 segundos
  }

  /**
   * Detiene el chequeo periódico
   */
  function stopGatewayCheck() {
    if (gatewayCheckInterval) {
      clearInterval(gatewayCheckInterval);
      gatewayCheckInterval = null;
    }
  }

  async function executeSync() {
    if (isSyncing) {
      return;
    }

    // Verificar conexión al gateway antes de sincronizar
    if (!isGatewayConnected) {
      showNotification('Gateway no disponible. No se puede sincronizar.', 'error');
      showSyncError('El gateway no está disponible. Verifica que objetiva-sync-gateway esté funcionando.');
      return;
    }

    // Get selected queries
    const checkboxes = document.querySelectorAll('.query-checkbox:checked');
    const queryIds = Array.from(checkboxes).map(cb => cb.value);

    if (queryIds.length === 0) {
      showNotification('Debes seleccionar al menos una query', 'error');
      return;
    }

    const fullSync = document.getElementById('full-sync-checkbox').checked;
    const batchSize = document.getElementById('batch-size-select').value;

    try {
      isSyncing = true;
      updateSyncButton(true);

      // Limpiar progreso anterior y resultados guardados
      clearQueryProgress();
      try { localStorage.removeItem('lastSyncResults'); } catch(e) {}

      // Show loading state
      showSyncProgress('Iniciando sincronización...');

      // Crear EventSource para recibir actualizaciones de progreso (usando queryIds)
      currentEventSource = new EventSource(
        `/api/sync/stream?queryIds=${queryIds.join(',')}&fullSync=${fullSync}&batchSize=${batchSize}`
      );

      currentEventSource.addEventListener('progress', (event) => {
        const progressData = JSON.parse(event.data);

        // Actualizar progreso en el checkbox de la query
        if (progressData.queryId && progressData.current && progressData.total) {
          updateQueryProgress(progressData.queryId, progressData.current, progressData.total);
        }

        // Actualizar vista de progreso detallada
        updateProgress(progressData);
      });

      currentEventSource.addEventListener('complete', (event) => {
        try {
          const result = JSON.parse(event.data);
          // Clear polling interval if exists
          if (statusPollInterval) {
            clearInterval(statusPollInterval);
            statusPollInterval = null;
          }

          if (currentEventSource) {
            currentEventSource.close();
            currentEventSource = null;
          }

          if (result.success) {
            showSyncResults(result);
            // Guardar resultados en localStorage para persistir en refresh
            try { localStorage.setItem('lastSyncResults', JSON.stringify(result)); } catch(e) {}
            showNotification('Sincronización completada', 'success');
          } else {
            showSyncError(result.error || 'Error al ejecutar sincronización');
            showNotification(result.error || 'Error al ejecutar sincronización', 'error');
          }
        } catch (err) {
          console.error('Error en handler de complete:', err);
        } finally {
          // SIEMPRE resetear el botón, sin importar errores
          isSyncing = false;
          updateSyncButton(false);
        }
      });

      currentEventSource.addEventListener('error', (event) => {
        console.error('Error en sincronización SSE (custom event):', event);
        finishSync('Error de conexión con el servidor');
      });

      // Handler nativo de EventSource - se dispara cuando la conexión se cierra
      currentEventSource.onerror = function(event) {
        // Solo actuar si la conexión se cerró definitivamente
        if (currentEventSource && currentEventSource.readyState === EventSource.CLOSED) {
          console.warn('EventSource cerrado por el servidor');
          // Si todavía estamos en estado de sync, resetear
          if (isSyncing) {
            // Dar un momento para que el evento 'complete' se procese primero
            setTimeout(() => {
              if (isSyncing) {
                console.warn('Reseteando botón - EventSource cerrado sin evento complete');
                finishSync(null); // Sin error - el sync probablemente terminó OK
              }
            }, 1000);
          }
        }
      };

    } catch (error) {
      console.error('Error en sincronización:', error);
      showSyncError(error.message || 'Error de conexión');
      showNotification('Error al ejecutar sincronización', 'error');
      isSyncing = false;
      updateSyncButton(false);
    }
  }

  function updateSyncButton(syncing) {
    const executeBtn = document.getElementById('execute-sync-btn');

    if (syncing) {
      executeBtn.disabled = true;
      executeBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Sincronizando...';
    } else {
      executeBtn.disabled = false;
      executeBtn.innerHTML = '<i data-lucide="play-circle" class="w-4 h-4"></i> Ejecutar Sincronización';
    }
    if (window.lucide) lucide.createIcons();
  }

  /**
   * Limpia estado de sync y resetea UI. Usado como safety net.
   */
  function finishSync(errorMessage) {
    // Clear polling interval
    if (statusPollInterval) {
      clearInterval(statusPollInterval);
      statusPollInterval = null;
    }

    // Close EventSource
    if (currentEventSource) {
      currentEventSource.close();
      currentEventSource = null;
    }

    // Show error if provided
    if (errorMessage) {
      showSyncError(errorMessage);
      showNotification(errorMessage, 'error');
    }

    // SIEMPRE resetear estado
    isSyncing = false;
    updateSyncButton(false);
  }

  async function cancelSync() {
    // Allow cancellation if syncing, regardless of connection method (EventSource or polling)
    if (!isSyncing) {
      return;
    }

    try {
      // Show canceling message
      showSyncProgress('Cancelando sincronización...');

      // Notificar al servidor que se canceló
      await fetch('/api/sync/cancel', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({}) // Fastify requiere body cuando se especifica Content-Type: application/json
      });

      // Clear polling interval if it exists
      if (statusPollInterval) {
        clearInterval(statusPollInterval);
        statusPollInterval = null;
      }

      // Close the EventSource connection if it exists
      if (currentEventSource) {
        currentEventSource.close();
        currentEventSource = null;
      }

      // Wait for server to confirm cancellation by polling status
      let attempts = 0;
      const maxAttempts = 10; // Wait up to 10 seconds

      while (attempts < maxAttempts) {
        await new Promise(resolve => setTimeout(resolve, 1000)); // Wait 1 second

        try {
          const statusResponse = await fetch('/api/sync/current-status');
          const statusResult = await statusResponse.json();

          if (!statusResult.success || !statusResult.data || statusResult.data.status !== 'running') {
            // Sync is no longer running - cancellation confirmed
            break;
          }
        } catch (error) {
          console.error('Error checking sync status during cancellation:', error);
          break;
        }

        attempts++;
      }

      // Reset state
      isSyncing = false;
      updateSyncButton(false);

      // Show cancellation message
      showSyncError('Sincronización cancelada por el usuario');
      showNotification('Sincronización cancelada', 'warning');

      // Trigger status reload
      htmx.trigger('#sync-status-container', 'load');
    } catch (error) {
      console.error('Error al cancelar sincronización:', error);
      showNotification('Error al cancelar sincronización', 'error');
    }
  }

  function showSyncProgress(message) {
    const container = document.getElementById('sync-results-container');
    container.innerHTML = `
      <div class="py-8">
        <!-- Encabezado con spinner -->
        <div class="text-center mb-6">
          <span class="loading loading-spinner loading-lg text-primary"></span>
          <p class="text-base font-semibold mb-1 mt-3">${escapeHtml(message)}</p>
        </div>

        <!-- Contenedor de progreso (se actualiza dinámicamente) -->
        <div class="max-w-2xl mx-auto space-y-4" id="progress-container">
          <div class="text-center text-sm opacity-60">
            Iniciando...
          </div>
        </div>

        <!-- Cancel Button (fuera de progress-container para no recrearse en cada update) -->
        <div class="mt-4 flex justify-center" id="cancel-sync-container">
          <button
            onclick="cancelSync()"
            class="btn btn-error gap-2"
          >
            <i data-lucide="x-circle" class="w-4 h-4"></i>
            Cancelar Sincronización
          </button>
        </div>
      </div>
    `;
    if (window.lucide) lucide.createIcons();
  }

  function updateProgress(progressData) {
    const container = document.getElementById('progress-container');
    if (!container) return;

    const { entityType, current, total, percentage, estimatedTimeRemaining, status } = progressData;

    const entityLabel = entityType === 'articulo' ? '📦 Artículos' :
                       entityType === 'comprobante_cabecera' ? '📄 Comprobantes Cabecera' :
                       entityType === 'comprobante_detalle' ? '📋 Comprobantes Detalle' :
                       entityType === 'comprobante_pago' ? '💳 Comprobantes Pago' : entityType;

    // Formatear tiempo estimado
    let timeText = 'Calculando...';
    if (estimatedTimeRemaining !== null && estimatedTimeRemaining !== undefined) {
      const minutes = Math.floor(estimatedTimeRemaining / 60);
      const seconds = Math.floor(estimatedTimeRemaining % 60);
      timeText = `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }

    container.innerHTML = `
      <!-- Entidad actual -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-medium text-blue-900">${entityLabel}</span>
          <span class="text-xs text-blue-700">${escapeHtml(status || 'Procesando')}</span>
        </div>

        <!-- Contador de registros -->
        <div class="mb-3">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-700">Progreso</span>
            <span class="font-semibold text-gray-900">${current} de ${total}</span>
          </div>

          <!-- Barra de progreso real -->
          <div class="w-full bg-blue-100 rounded-full h-3 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-3 rounded-full transition-all duration-300 ease-out"
                 style="width: ${percentage}%"></div>
          </div>

          <div class="flex justify-between text-xs mt-1">
            <span class="text-gray-600">${percentage.toFixed(1)}% completado</span>
            <span class="text-gray-600">Tiempo estimado: ${timeText}</span>
          </div>
        </div>
      </div>
    `;
    if (window.lucide) lucide.createIcons();
  }

  function showSyncResults(result) {
    const { summary, results, syncType } = result;

    // Determine sync type badge
    const syncTypeLabel = syncType === 'full' ? 'COMPLETA' : 'INCREMENTAL';
    const syncTypeBadgeClass = syncType === 'full' ? 'badge-warning' : 'badge-primary';

    const html = `
      <!-- Summary Card -->
      <div class="bg-gradient-to-r from-blue-50 to-blue-100 rounded-lg p-4 mb-4">
        <h4 class="text-md font-semibold text-blue-900 mb-2">
          <i data-lucide="check-circle" class="w-5 h-5 inline-block mr-2"></i>
          Resumen de Sincronización
          <span class="badge ${syncTypeBadgeClass} badge-sm ml-2">${syncTypeLabel}</span>
        </h4>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <p class="text-xs text-blue-700">Entidades</p>
            <p class="text-lg font-bold text-blue-900">${summary.totalEntities}</p>
          </div>
          <div>
            <p class="text-xs text-green-700">Exitosas</p>
            <p class="text-lg font-bold text-green-900">${summary.successful}</p>
          </div>
          <div>
            <p class="text-xs text-red-700">Fallidas</p>
            <p class="text-lg font-bold text-red-900">${summary.failed}</p>
          </div>
          <div>
            <p class="text-xs text-blue-700">Registros</p>
            <p class="text-lg font-bold text-blue-900">${summary.totalSent || 0}</p>
          </div>
        </div>
      </div>

      <!-- Detailed Results -->
      <div class="space-y-3">
        ${results
          .map(
            (r) => `
          <div class="border ${r.status === 'success' ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50'} rounded-lg p-4">
            <div class="flex items-center justify-between mb-2">
              <h5 class="text-sm font-medium ${r.status === 'success' ? 'text-green-900' : 'text-red-900'}">
                ${r.entityType === 'articulo' ? '📦 Artículos' :
                  r.entityType === 'comprobante_cabecera' ? '📄 Comprobantes Cabecera' :
                  r.entityType === 'comprobante_detalle' ? '📋 Comprobantes Detalle' :
                  r.entityType === 'comprobante_pago' ? '💳 Comprobantes Pago' : r.entityType}
              </h5>
              <span class="text-xs font-semibold ${r.status === 'success' ? 'text-green-700' : 'text-red-700'}">
                ${r.status === 'success' ? '✓ ÉXITO' : '✗ FALLÓ'}
              </span>
            </div>
            ${
              r.status === 'success'
                ? `
              <div class="grid grid-cols-2 gap-2 text-xs ${r.status === 'success' ? 'text-green-700' : 'text-red-700'}">
                <div>Procesados: <span class="font-semibold">${r.recordsProcessed || 0}</span></div>
                <div>Enviados: <span class="font-semibold">${r.recordsSent || 0}</span></div>
                <div>Duración: <span class="font-semibold">${r.durationMs ? (r.durationMs / 1000).toFixed(2) + 's' : 'N/A'}</span></div>
                ${r.logId ? `<div><button onclick="viewLogDetails(${r.logId})" class="text-blue-600 hover:text-blue-800 underline text-xs">Ver detalles</button></div>` : ''}
              </div>
            `
                : `
              <p class="text-xs text-red-700 mb-2">Error: ${escapeHtml(r.error || 'Desconocido')}</p>
              ${r.recordsFailed > 0 ? `<p class="text-xs text-red-700 font-semibold">Registros fallidos: ${r.recordsFailed}</p>` : ''}
              ${r.logId ? `<button onclick="viewLogDetails(${r.logId})" class="mt-2 inline-flex items-center px-3 py-1 border border-red-300 text-xs font-medium rounded-md text-red-700 bg-white hover:bg-red-50"><i data-lucide="alert-circle" class="w-3 h-3 mr-1"></i> Ver errores detallados</button>` : ''}
            `
            }
          </div>
        `
          )
          .join('')}
      </div>
    `;

    const container = document.getElementById('sync-results-container');
    container.innerHTML = html;
    if (window.lucide) lucide.createIcons();

    // Refresh sync state and history after sync completes
    loadSyncState();
    loadSyncHistory();
  }

  function showSyncError(message) {
    const container = document.getElementById('sync-results-container');
    container.innerHTML = `
      <div class="text-center py-8 text-red-600">
        <i data-lucide="alert-circle" class="h-12 w-12 mx-auto mb-3"></i>
        <p class="text-sm font-medium">Error en Sincronización</p>
        <p class="text-xs mt-2">${escapeHtml(message)}</p>
      </div>
    `;
    if (window.lucide) lucide.createIcons();
  }

  function hideSyncProgress() {
    const container = document.getElementById('sync-results-container');
    container.innerHTML = `
      <div class="flex items-center justify-center h-48">
        <div class="text-center">
          <i data-lucide="activity" class="w-12 h-12 mx-auto mb-3 opacity-30"></i>
          <p class="text-sm opacity-60">Selecciona entidades y haz clic en "Ejecutar Sincronización" para comenzar</p>
        </div>
      </div>
    `;
    if (window.lucide) lucide.createIcons();
  }

  function escapeHtml(unsafe) {
    if (typeof unsafe !== 'string') return '';
    return unsafe
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Check for ongoing sync on page load
  async function checkOngoingSync() {
    try {
      const response = await fetch('/api/sync/current-status');
      const result = await response.json();

      if (result.success && result.data && result.data.status === 'running' && result.data.status !== 'canceled') {
        const syncData = result.data;

        // Show sync in progress
        isSyncing = true;
        updateSyncButton(true);

        // Update progress display with current state
        showSyncProgress(`Reconectando a sincronización en progreso...`);

        // Update progress with current data
        if (syncData.processedRecords > 0) {
          const percentage = syncData.totalRecords > 0
            ? Math.round((syncData.processedRecords / syncData.totalRecords) * 100)
            : 0;

          updateProgress({
            entityType: syncData.entityType,
            current: syncData.processedRecords,
            total: syncData.totalRecords || syncData.processedRecords,
            percentage: percentage,
            status: 'Procesando',
            estimatedTimeRemaining: null,
          });
        }

        // Reconnect to SSE stream to receive further updates
        // Note: We need to know which entities were being synced
        // For now, we'll just poll for updates
        statusPollInterval = setInterval(async () => {
          try {
            const statusResponse = await fetch('/api/sync/current-status');
            const statusResult = await statusResponse.json();

            if (!statusResult.success || !statusResult.data || statusResult.data.status !== 'running') {
              // Sync completed or failed
              if (statusPollInterval) {
              clearInterval(statusPollInterval);
              statusPollInterval = null;
            }
              isSyncing = false;
              updateSyncButton(false);

              if (statusResult.data && statusResult.data.status === 'completed') {
                showNotification('Sincronización completada', 'success');
                // Refresh results
                location.reload();
              } else if (statusResult.data && statusResult.data.status === 'failed') {
                showNotification(`Sincronización falló: ${statusResult.data.error || 'Error desconocido'}`, 'error');
                hideSyncProgress();
              } else if (statusResult.data && statusResult.data.status === 'canceled') {
                showNotification('Sincronización cancelada', 'warning');
                hideSyncProgress();
              }
              return;
            }

            // Update progress with latest data
            const latestData = statusResult.data;
            const percentage = latestData.totalRecords > 0
              ? Math.round((latestData.processedRecords / latestData.totalRecords) * 100)
              : 0;

            updateProgress({
              entityType: latestData.entityType,
              current: latestData.processedRecords,
              total: latestData.totalRecords || latestData.processedRecords,
              percentage: percentage,
              status: 'Procesando',
              estimatedTimeRemaining: null,
            });
          } catch (error) {
            console.error('Error polling sync status:', error);
          }
        }, 1000); // Poll every second
      }
    } catch (error) {
      console.error('Error checking ongoing sync:', error);
    }
  }

  // Función para ver detalles del log (abre modal)
  function viewLogDetails(logId) {
    htmx.ajax('GET', '/api/logs/' + logId + '/details', {
      target: 'body',
      swap: 'beforeend'
    });
  }

  // Función para cerrar modal de detalles
  function closeLogDetails() {
    const modal = document.getElementById('log-details-modal');
    if (modal) {
      modal.remove();
    }
  }

  // Make functions globally available
  window.executeSync = executeSync;
  window.viewLogDetails = viewLogDetails;
  window.closeLogDetails = closeLogDetails;

  // Refresh icons after HTMX swaps
  document.body.addEventListener('htmx:afterSwap', function() {
    if (window.lucide) lucide.createIcons();
  });

  /**
   * Restaurar últimos resultados de sync desde localStorage
   */
  function restoreLastSyncResults() {
    try {
      const saved = localStorage.getItem('lastSyncResults');
      if (saved) {
        const result = JSON.parse(saved);
        showSyncResults(result);
      }
    } catch (e) {
      console.error('Error restaurando resultados:', e);
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    loadAvailableQueries();
    checkOngoingSync();
    startGatewayCheck();

    // Si no hay sync en progreso, restaurar últimos resultados
    if (!isSyncing) {
      restoreLastSyncResults();
    }

    // Load sync state and history
    loadSyncState();
    loadSyncHistory();

    // Update sync mode indicator on checkbox change
    updateSyncModeIndicator();
    const fullSyncCheckbox = document.getElementById('full-sync-checkbox');
    if (fullSyncCheckbox) {
      fullSyncCheckbox.addEventListener('change', updateSyncModeIndicator);
    }
  });

  // Stop gateway check when page unloads
  window.addEventListener('beforeunload', function() {
    stopGatewayCheck();
  });
</script>
