  // Delete query
  async function deleteQueryById(queryId) {
    // Verificar si hay un editor abierto (creando o editando)
    const editorContainer = document.getElementById('query-editor-container');
    if (!editorContainer.classList.contains('hidden')) {
      showNotification('Cierra el editor de consultas antes de eliminar', 'error');
      return;
    }

    if (!confirm('¿Estás seguro de que deseas eliminar esta consulta?')) {
      return;
    }

    try {
      const response = await fetch(`/api/queries/${queryId}`, {
        method: 'DELETE',
      });

      const result = await response.json();

      if (result.success) {
        showNotification('Consulta eliminada exitosamente', 'success');
        // Trigger refresh of queries list
        htmx.trigger('body', 'queryUpdated');
      } else {
        showNotification(result.error || 'Error al eliminar consulta', 'error');
      }
    } catch (error) {
      console.error('Error deleting query:', error);
      showNotification('Error al eliminar consulta', 'error');
    }
  }

  // Test and validate query (NUEVA FUNCIÓN - FASE 4)
  async function testAndValidateQuery() {
    const sqlQuery = document.getElementById('query-sql').value;
    const entityType = document.getElementById('query-entity-type').value;
    const queryId = document.getElementById('query-id').value;
    const connectionId = document.getElementById('query-connection-id')?.value || '';

    if (!sqlQuery.trim()) {
      showNotification('Por favor ingresa una consulta SQL', 'error');
      return;
    }

    if (!entityType) {
      showNotification('Por favor selecciona un tipo de entidad', 'error');
      return;
    }

    // Abrir modal
    openValidationModal();

    // Cargar referencia de schema en la segunda pestaña
    loadSchemaReferenceInModal(entityType);

    const resultsDiv = document.getElementById('modal-validation-results');
    resultsDiv.innerHTML = '<div class="text-center py-8"><span class="loading loading-spinner loading-lg text-primary"></span><p class="mt-2 text-sm">Ejecutando y validando consulta...</p></div>';

    if (window.lucide) lucide.createIcons();

    try {
      const requestBody = { sqlQuery, entityType, connectionId: connectionId || undefined };
      if (queryId) {
        requestBody.queryId = parseInt(queryId, 10);
      }

      const response = await fetch('/api/queries/test-and-validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });

      const result = await response.json();

      if (!result.success) {
        resultsDiv.innerHTML = `
          <div class="alert alert-error">
            <i data-lucide="alert-circle" class="h-5 w-5"></i>
            <span>${result.error || 'Error al ejecutar la query'}</span>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      // Renderizar resultados de validación
      const { rowCount, totalCount, incrementalInfo, sampleData, validation } = result;

      let html = '';

      // Info de registros totales e incremental
      const totalDisplay = totalCount > 0 ? totalCount.toLocaleString() : '?';
      const sampleText = totalCount > 10
        ? `Mostrando ${rowCount} de ${totalDisplay} registros`
        : `${rowCount} registros`;

      // Header con resultado general
      if (validation.isValid) {
        html += `
          <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-4">
            <div class="flex">
              <i data-lucide="check-circle" class="h-5 w-5 text-green-400"></i>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-green-800">✅ Validación Exitosa!</h3>
                <p class="mt-1 text-sm text-green-700">
                  ${sampleText}. Todos los datos cumplen con el schema esperado.
                </p>
              </div>
            </div>
          </div>
        `;
      } else {
        html += `
          <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
            <div class="flex">
              <i data-lucide="x-circle" class="h-5 w-5 text-red-400"></i>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">❌ Validación Fallida</h3>
                <p class="mt-1 text-sm text-red-700">
                  ${sampleText}, pero los datos NO cumplen con el schema.
                </p>
              </div>
            </div>
          </div>
        `;
      }

      // Campos requeridos
      const requiredFieldsHTML = Object.entries(validation.requiredFields || {}).map(([field, info]) => {
        const statusColors = {
          'OK': 'bg-green-100 text-green-800',
          'MISSING': 'bg-red-100 text-red-800',
          'TYPE_ERROR': 'bg-red-100 text-red-800',
          'VALIDATION_ERROR': 'bg-red-100 text-red-800'
        };
        const statusIcons = {
          'OK': 'check',
          'MISSING': 'x',
          'TYPE_ERROR': 'alert-triangle',
          'VALIDATION_ERROR': 'alert-triangle'
        };

        return `
          <div class="flex items-start p-2 border-b border-gray-200 last:border-0">
            <i data-lucide="${statusIcons[info.status]}" class="h-4 w-4 mt-0.5 mr-2 ${info.status === 'OK' ? 'text-green-500' : 'text-red-500'}"></i>
            <div class="flex-1">
              <code class="text-sm font-mono">${field}</code>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${statusColors[info.status]}">
                ${info.status}
              </span>
              ${info.error ? `<p class="mt-1 text-xs text-red-600">${info.error}</p>` : ''}
            </div>
          </div>
        `;
      }).join('');

      html += `
        <div class="mt-4 bg-white border border-gray-200 rounded-md overflow-hidden">
          <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
            <h4 class="text-sm font-medium text-gray-900">Campos Requeridos</h4>
          </div>
          <div class="divide-y divide-gray-200">
            ${requiredFieldsHTML}
          </div>
        </div>
      `;

      // Campos fuera de modelo (extra fields)
      if (sampleData && sampleData.length > 0) {
        const columns = Object.keys(sampleData[0]);
        const requiredFieldNames = Object.keys(validation.requiredFields || {});
        const optionalFieldNames = Object.keys(validation.optionalFields || {});
        const extraFields = columns.filter(col => !requiredFieldNames.includes(col) && !optionalFieldNames.includes(col));

        if (extraFields.length > 0) {
          const extraFieldsHTML = extraFields.map(field => `
            <div class="flex items-start p-2 border-b border-gray-200 last:border-0">
              <i data-lucide="alert-circle" class="h-4 w-4 mt-0.5 mr-2 text-yellow-500"></i>
              <div class="flex-1">
                <code class="text-sm font-mono">${field}</code>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                  EXTRA
                </span>
                <p class="mt-1 text-xs text-gray-600">Este campo no está en el modelo del schema</p>
              </div>
            </div>
          `).join('');

          html += `
            <div class="mt-4 bg-white border border-yellow-200 rounded-md overflow-hidden">
              <div class="px-4 py-3 bg-yellow-50 border-b border-yellow-200">
                <h4 class="text-sm font-medium text-gray-900">⚠️ Campos Fuera de Modelo</h4>
                <p class="text-xs text-gray-600 mt-1">Estos campos están en tu consulta pero no son parte del schema esperado</p>
              </div>
              <div class="divide-y divide-gray-200">
                ${extraFieldsHTML}
              </div>
            </div>
          `;
        }
      }

      // Errores de validación (si hay)
      if (validation.validationErrors && validation.validationErrors.length > 0) {
        const errorsHTML = validation.validationErrors.slice(0, 10).map(err => `
          <li class="text-sm text-red-700">
            Fila ${err.rowIndex + 1}, campo <code class="bg-red-100 px-1 rounded">${err.fieldPath.join('.')}</code>: ${err.error}
          </li>
        `).join('');

        html += `
          <div class="mt-4 bg-red-50 border border-red-200 rounded-md p-4">
            <h4 class="text-sm font-semibold text-red-900 mb-2">Errores de Validación (${validation.validationErrors.length}):</h4>
            <ul class="list-disc list-inside space-y-1">
              ${errorsHTML}
            </ul>
            ${validation.validationErrors.length > 10 ? `<p class="mt-2 text-xs text-red-600">...y ${validation.validationErrors.length - 10} errores más</p>` : ''}
          </div>
        `;
      }

      // Recomendaciones
      if (validation.recommendations && validation.recommendations.length > 0) {
        const recommendationsHTML = validation.recommendations.map(rec => `
          <li class="text-sm text-blue-700">${rec}</li>
        `).join('');

        html += `
          <div class="mt-4 bg-blue-50 border border-blue-200 rounded-md p-4">
            <h4 class="text-sm font-semibold text-blue-900 mb-2">💡 Recomendaciones:</h4>
            <ul class="list-disc list-inside space-y-1">
              ${recommendationsHTML}
            </ul>
          </div>
        `;
      }

      // Datos de muestra
      if (sampleData && sampleData.length > 0) {
        const columns = Object.keys(sampleData[0]);

        // Clasificar columnas según tipo
        const requiredFieldNames = Object.keys(validation.requiredFields || {});
        const optionalFieldNames = Object.keys(validation.optionalFields || {});

        const getFieldType = (col) => {
          if (requiredFieldNames.includes(col)) return 'required';
          if (optionalFieldNames.includes(col)) return 'optional';
          return 'extra';
        };

        const getHeaderStyle = (type) => {
          if (type === 'required') return 'background-color: #c8e6c9;';
          if (type === 'optional') return 'background-color: #bbdefb;';
          return 'background-color: #e0e0e0;';
        };

        const getCellStyle = (type) => {
          if (type === 'required') return 'background-color: #e0f2e0;';
          if (type === 'optional') return 'background-color: #e3f2fd;';
          return 'background-color: #f0f0f0;';
        };

        const truncateText = (text, maxLength = 35) => {
          const str = JSON.stringify(text);
          if (str.length <= maxLength) return str;
          return str.substring(0, maxLength) + '...';
        };

        const rowsHTML = sampleData.slice(0, 10).map(row => `
          <tr>
            ${columns.map(col => {
              const fieldType = getFieldType(col);
              return `<td class="px-2 py-1 text-xs text-gray-900" style="${getCellStyle(fieldType)} white-space: nowrap;">${truncateText(row[col])}</td>`;
            }).join('')}
          </tr>
        `).join('');

        const sampleHeader = totalCount > 10
          ? `Datos de Muestra (primeras 10 filas de ${totalCount.toLocaleString()}):`
          : `Datos de Muestra (${sampleData.length} filas):`;

        html += `
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-900 mb-2">${sampleHeader}</h4>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200 border border-gray-200 rounded-md text-xs">
                <thead>
                  <tr>
                    ${columns.map(col => {
                      const fieldType = getFieldType(col);
                      return `<th class="px-2 py-1 text-left text-xs font-medium text-gray-700" style="${getHeaderStyle(fieldType)}">${col}</th>`;
                    }).join('')}
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  ${rowsHTML}
                </tbody>
              </table>
            </div>

            <!-- Leyenda de colores -->
            <div class="mt-3 flex flex-wrap gap-4 text-xs text-gray-600">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 rounded" style="background-color: #c8e6c9;"></div>
                <span>✅ Campos Requeridos</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 rounded" style="background-color: #bbdefb;"></div>
                <span>🔵 Campos Opcionales</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 rounded" style="background-color: #e0e0e0;"></div>
                <span>⚪ Campos Fuera de Modelo</span>
              </div>
            </div>
          </div>
        `;
      }

      resultsDiv.innerHTML = html;
      if (window.lucide) lucide.createIcons();

      // No poblar el dropdown aquí - el usuario usa el dropdown de campo incremental
      // que carga solo campos de fecha al desplegarlo

    } catch (error) {
      console.error('Error validating query:', error);
      resultsDiv.innerHTML = `
        <div class="bg-red-50 border-l-4 border-red-400 p-4">
          <div class="flex">
            <i data-lucide="alert-circle" class="h-5 w-5 text-red-400"></i>
            <div class="ml-3">
              <p class="text-sm text-red-700">Error al ejecutar validación: ${error.message}</p>
            </div>
          </div>
        </div>
      `;
      if (window.lucide) lucide.createIcons();
    }
  }

  // Modal management functions
  function openValidationModal() {
    const modal = document.getElementById('validation-modal');
    modal.showModal();

    // Inicializar iconos de Lucide en el modal
    setTimeout(() => {
      if (window.lucide) {
        lucide.createIcons();
      }
    }, 50);

    // Asegurarse de que la primera pestaña esté activa
    switchTab('results');
  }

  function closeValidationModal() {
    const modal = document.getElementById('validation-modal');
    modal.close();
  }

  function switchTab(tabName) {
    // Update tab buttons (DaisyUI tabs) - buscar dentro del modal
    const modal = document.getElementById('validation-modal');
    const allTabs = modal.querySelectorAll('[role="tab"]');
    allTabs.forEach(tab => {
      tab.classList.remove('tab-active');
    });

    const activeTab = document.getElementById(`tab-${tabName}`);
    if (activeTab) {
      activeTab.classList.add('tab-active');
    }

    // Update tab content - usar display en lugar de clases hidden
    const allContent = modal.querySelectorAll('.tab-panel');
    allContent.forEach(content => {
      content.style.display = 'none';
    });

    const activeContent = document.getElementById(`tab-content-${tabName}`);
    if (activeContent) {
      activeContent.style.display = 'block';
    }

    // Refresh lucide icons
    if (window.lucide) {
      lucide.createIcons();
    }
  }

  async function loadSchemaReferenceInModal(entityType) {
    const schemaRefDiv = document.getElementById('modal-schema-reference');

    if (!entityType) {
      schemaRefDiv.innerHTML = '<p class="text-sm text-gray-500">Selecciona un tipo de entidad primero</p>';
      return;
    }

    schemaRefDiv.innerHTML = '<div class="text-center py-8"><i data-lucide="loader" class="h-8 w-8 mx-auto animate-spin text-blue-600"></i><p class="mt-2 text-sm text-gray-500">Cargando referencia de campos...</p></div>';
    if (window.lucide) lucide.createIcons();

    try {
      const schemaInfo = await loadSchemaInfo(entityType);

      const entityLabels = {
        'articulo': 'Artículos',
        'comprobante_cabecera': 'Comprobantes - Cabecera',
        'comprobante_detalle': 'Comprobantes - Detalle',
        'comprobante_pago': 'Comprobantes - Pagos'
      };

      // Render required fields as table rows
      const requiredFieldsHTML = schemaInfo.required.map(field => `
        <tr class="border-b border-gray-200">
          <td class="px-2 py-2 text-xs font-mono font-semibold text-gray-900 bg-gray-50" style="width: 200px;">${escapeHtml(field.name)}</td>
          <td class="px-2 py-2 text-xs text-center bg-gray-50" style="width: 100px;">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
              ${escapeHtml(field.type)}
            </span>
          </td>
          <td class="px-2 py-2 text-xs text-gray-600 bg-gray-50" style="width: 250px;">${escapeHtml(field.description)}</td>
          <td class="px-2 py-2 text-xs text-gray-500 bg-gray-50" style="width: 200px;">
            <code class="bg-gray-100 px-1 rounded">${escapeHtml(field.example)}</code>
          </td>
        </tr>
      `).join('');

      // Render optional fields as table rows
      const optionalFieldsHTML = schemaInfo.optional.map(field => `
        <tr class="border-b border-gray-200">
          <td class="px-2 py-2 text-xs font-mono font-semibold text-gray-900" style="width: 200px;">${escapeHtml(field.name)}</td>
          <td class="px-2 py-2 text-xs text-center" style="width: 100px;">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">
              ${escapeHtml(field.type)}
            </span>
          </td>
          <td class="px-2 py-2 text-xs text-gray-600" style="width: 250px;">${escapeHtml(field.description)}</td>
          <td class="px-2 py-2 text-xs text-gray-500" style="width: 200px;">
            <code class="bg-gray-100 px-1 rounded">${escapeHtml(field.example)}</code>
          </td>
        </tr>
      `).join('');

      schemaRefDiv.innerHTML = `
        <div>
          <div class="mb-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              📋 Referencia de Campos para ${entityLabels[entityType] || entityType}
            </h3>
          </div>

          <!-- Required Fields -->
          <div class="mb-6">
            <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 mr-2">
                REQUERIDO
              </span>
              Campos Obligatorios
            </h4>
            <table class="w-full border border-gray-200 rounded-md text-xs">
              <thead class="bg-gray-100">
                <tr>
                  <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 200px;">Campo</th>
                  <th class="px-2 py-2 text-center font-semibold text-gray-700" style="width: 100px;">Tipo</th>
                  <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 250px;">Descripción</th>
                  <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 200px;">Ejemplo</th>
                </tr>
              </thead>
              <tbody>
                ${requiredFieldsHTML}
              </tbody>
            </table>
          </div>

          <!-- Optional Fields -->
          <div class="border-t border-gray-200 pt-6">
            <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 mr-2">
                OPCIONAL
              </span>
              Campos Opcionales
            </h4>
            <div class="max-h-96 overflow-y-auto">
              <table class="w-full border border-gray-200 rounded-md text-xs">
                <thead class="bg-gray-100 sticky top-0">
                  <tr>
                    <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 200px;">Campo</th>
                    <th class="px-2 py-2 text-center font-semibold text-gray-700" style="width: 100px;">Tipo</th>
                    <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 250px;">Descripción</th>
                    <th class="px-2 py-2 text-left font-semibold text-gray-700" style="width: 200px;">Ejemplo</th>
                  </tr>
                </thead>
                <tbody>
                  ${optionalFieldsHTML}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Naming Convention Info -->
          <div class="border-t border-gray-200 pt-6 mt-6">
            <div class="bg-blue-50 border-l-4 border-blue-400 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i data-lucide="info" class="h-5 w-5 text-blue-400"></i>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-blue-700">
                    <strong>Importante:</strong> Los alias de tu query SQL deben coincidir <strong>exactamente</strong> con los nombres de campo mostrados (snake_case).
                  </p>
                  <p class="mt-2 text-sm text-blue-700">
                    Ejemplo: <code class="bg-blue-100 px-1 rounded">SELECT codigo AS erp_codigo, nombre AS erp_nombre FROM articulos</code>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      if (window.lucide) lucide.createIcons();

    } catch (error) {
      console.error('Error loading schema reference:', error);
      schemaRefDiv.innerHTML = `
        <div class="bg-red-50 border-l-4 border-red-400 p-4">
          <div class="flex">
            <i data-lucide="alert-circle" class="h-5 w-5 text-red-400"></i>
            <div class="ml-3">
              <p class="text-sm text-red-700">Error al cargar referencia de schema: ${error.message}</p>
            </div>
          </div>
        </div>
      `;
      if (window.lucide) lucide.createIcons();
    }
  }

  // Helper para formatear fechas
  function formatDateTime(isoString) {
    if (!isoString) return '--';
    try {
      const date = new Date(isoString);
      return date.toLocaleString('es-ES', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      });
    } catch {
      return isoString;
    }
  }

  // Make functions globally available
  window.showQueryForm = showQueryForm;
  window.hideQueryForm = hideQueryForm;
  window.testQuery = testQuery;
  window.testAndValidateQuery = testAndValidateQuery;
  window.toggleIncrementalField = toggleIncrementalField;
  window.loadIncrementalFieldOptions = loadIncrementalFieldOptions;
  window.updateIncrementalExample = updateIncrementalExample;
  window.copyIncrementalClause = copyIncrementalClause;
  window.toggleSyncIntervalField = toggleSyncIntervalField;
  window.loadQueryForEdit = loadQueryForEdit;
  window.deleteQueryById = deleteQueryById;
  window.openValidationModal = openValidationModal;
  window.closeValidationModal = closeValidationModal;
  window.switchTab = switchTab;

  // ========================================
  // Unsaved changes warning
  // ========================================
  let formHasUnsavedChanges = false;
  let initialFormState = null;

  function getFormState() {
    const form = document.getElementById('query-form');
    if (!form) return null;

    return {
      name: document.getElementById('query-name')?.value || '',
      entityType: document.getElementById('query-entity-type')?.value || '',
      sqlQuery: document.getElementById('query-sql')?.value || '',
      incrementalType: document.getElementById('query-incremental-type')?.value || '',
      incrementalField: document.getElementById('query-incremental-field')?.value || '',
      connectionId: document.getElementById('query-connection-id')?.value || '',
      isActive: document.getElementById('query-is-active')?.checked || false,
      isScheduled: document.getElementById('query-is-scheduled')?.checked || false,
      syncInterval: document.getElementById('query-sync-interval')?.value || '1800'
    };
  }

  function checkForChanges() {
    if (!initialFormState) return false;
    const currentState = getFormState();
    if (!currentState) return false;

    return JSON.stringify(initialFormState) !== JSON.stringify(currentState);
  }

  // Track form changes
  function setupFormChangeTracking() {
    const form = document.getElementById('query-form');
    if (!form) return;

    // Store initial state when form is shown
    initialFormState = getFormState();
    formHasUnsavedChanges = false;

    // Listen for any input changes
    form.addEventListener('input', () => {
      formHasUnsavedChanges = checkForChanges();
    });

    form.addEventListener('change', () => {
      formHasUnsavedChanges = checkForChanges();
    });
  }

  // Override showQueryForm to setup tracking
  const originalShowQueryForm = showQueryForm;
  showQueryForm = function(queryData) {
    originalShowQueryForm(queryData);
    // Wait for DOM to update, then setup tracking
    setTimeout(setupFormChangeTracking, 100);
  };
  window.showQueryForm = showQueryForm;

  // Override hideQueryForm to check for unsaved changes
  const originalHideQueryForm = hideQueryForm;
  hideQueryForm = function() {
    if (formHasUnsavedChanges) {
      if (!confirm('Hay cambios sin guardar. ¿Deseas salir sin guardar?')) {
        return;
      }
    }
    formHasUnsavedChanges = false;
    initialFormState = null;
    originalHideQueryForm();
  };
  window.hideQueryForm = hideQueryForm;

  // Warn before leaving page
  window.addEventListener('beforeunload', (e) => {
    if (formHasUnsavedChanges) {
      e.preventDefault();
      e.returnValue = 'Hay cambios sin guardar. ¿Estás seguro de que quieres salir?';
      return e.returnValue;
    }
  });

  // Clear unsaved changes flag after successful save
  const originalHandleQueryFormSubmit = handleQueryFormSubmit;
  handleQueryFormSubmit = async function(event) {
    const result = await originalHandleQueryFormSubmit(event);
    // If save was successful, clear the unsaved changes flag
    formHasUnsavedChanges = false;
    initialFormState = null;
    return result;
  };
</script>
