<div class="bg-white shadow sm:rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <!-- Status Header -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Estado del Scheduler
      </h3>
      <% if (enabled) { %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
          <svg class="w-2 h-2 mr-1.5" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3" />
          </svg>
          Activo
        </span>
      <% } else { %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
          <svg class="w-2 h-2 mr-1.5" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3" />
          </svg>
          Inactivo
        </span>
      <% } %>
    </div>

    <!-- Status Details -->
    <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Intervalo de Sincronización</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <% if (interval > 0) { %>
            Cada <%= interval %> minutos
          <% } else { %>
            Desactivado
          <% } %>
        </dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Jobs Activos</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= jobs.length %></dd>
      </div>
    </dl>

    <!-- Error Message -->
    <% if (error) { %>
      <div class="mt-4 bg-red-50 border border-red-200 rounded-md p-4">
        <p class="text-sm text-red-800"><%= error %></p>
      </div>
    <% } %>

    <!-- Jobs List -->
    <% if (enabled && jobs.length > 0) { %>
      <div class="mt-6">
        <h4 class="text-sm font-medium text-gray-900 mb-3">Jobs Programados</h4>
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Tipo
                </th>
                <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Intervalo
                </th>
                <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Última Ejecución
                </th>
                <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Próxima Ejecución
                </th>
                <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Estado
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% jobs.forEach(job => { %>
                <tr>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">
                    <% if (job.entityType === 'articulo') { %>
                      Artículos
                    <% } else if (job.entityType === 'comprobante') { %>
                      Comprobantes
                    <% } else if (job.entityType === 'pago') { %>
                      Pagos
                    <% } else if (job.entityType === 'retries') { %>
                      Reintentos
                    <% } else if (job.entityType === 'cleanup') { %>
                      Limpieza
                    <% } else { %>
                      <%= job.entityType %>
                    <% } %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= job.intervalMinutes %> min
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <% if (job.lastRun) { %>
                      <%= new Date(job.lastRun).toLocaleString('es-AR', {
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    <% } else { %>
                      <span class="text-gray-400">Nunca</span>
                    <% } %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <% if (job.nextRun) { %>
                      <%= new Date(job.nextRun).toLocaleString('es-AR', {
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    <% } else { %>
                      <span class="text-gray-400">-</span>
                    <% } %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <% if (job.enabled) { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Activo
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        Inactivo
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else if (!enabled) { %>
      <div class="mt-4 bg-yellow-50 border border-yellow-200 rounded-md p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">Scheduler Desactivado</h3>
            <p class="mt-1 text-sm text-yellow-700">
              El scheduler automático está desactivado. Configure un intervalo mayor a 0 para activar la sincronización automática.
            </p>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>
