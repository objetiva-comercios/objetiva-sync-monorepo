<div class="py-6 bg-base-200 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl font-bold mb-2">
          Dashboard
        </h1>
        <p class="text-base-content/60">
          Vista general del sistema de sincronización
        </p>
      </div>
      <div class="mt-4 sm:mt-0 sm:ml-4">
        <button
          type="button"
          onclick="loadDashboardStats()"
          class="btn btn-primary gap-2"
        >
          <i data-lucide="refresh-cw" class="w-4 h-4"></i>
          Actualizar
        </button>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats stats-vertical lg:stats-horizontal shadow w-full">
      <!-- Stat: Estado General -->
      <div class="stat">
        <div class="stat-figure text-primary">
          <i data-lucide="activity" class="w-10 h-10"></i>
        </div>
        <div class="stat-title">Estado del Sistema</div>
        <div class="stat-value text-primary">Activo</div>
        <div class="stat-desc flex items-center gap-1">
          <i data-lucide="check-circle" class="w-3 h-3"></i>
          Operando normalmente
        </div>
        <div class="stat-actions mt-2">
          <a href="/sync" class="btn btn-sm btn-primary">Ver sincronizaciones</a>
        </div>
      </div>

      <!-- Stat: Última Sincronización -->
      <div class="stat">
        <div class="stat-figure text-success">
          <i data-lucide="clock" class="w-10 h-10"></i>
        </div>
        <div class="stat-title">Última Sincronización</div>
        <div class="stat-value text-success" id="last-sync-time">--</div>
        <div class="stat-desc" id="last-sync-desc">Sin sincronizaciones</div>
        <div class="stat-actions mt-2">
          <a href="/logs" class="btn btn-sm btn-ghost">Ver logs</a>
        </div>
      </div>

      <!-- Stat: Consultas Activas -->
      <div class="stat">
        <div class="stat-figure text-warning">
          <i data-lucide="database" class="w-10 h-10"></i>
        </div>
        <div class="stat-title">Consultas Activas</div>
        <div class="stat-value text-warning" id="active-queries-count">0</div>
        <div class="stat-desc">Configuradas para sync</div>
        <div class="stat-actions mt-2">
          <a href="/config/queries" class="btn btn-sm btn-ghost">Configurar</a>
        </div>
      </div>

      <!-- Stat: Cola de Reintentos -->
      <div class="stat">
        <div class="stat-figure text-error">
          <i data-lucide="alert-circle" class="w-10 h-10"></i>
        </div>
        <div class="stat-title">Reintentos Pendientes</div>
        <div class="stat-value text-error" id="retry-queue-count">0</div>
        <div class="stat-desc">En cola de reintentos</div>
        <div class="stat-actions mt-2">
          <a href="/sync/retry-queue" class="btn btn-sm btn-ghost">Ver cola</a>
        </div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold">Estadísticas de Sincronización</h2>
        <div class="badge badge-primary badge-lg">Últimos 30 días</div>
      </div>

      <!-- Charts Grid -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <!-- Sync Status Pie Chart -->
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title">
              <i data-lucide="pie-chart" class="w-5 h-5"></i>
              Estado de Sincronizaciones
              <div class="badge badge-ghost badge-sm">7 días</div>
            </h3>
            <div class="relative" style="height: 300px;">
              <canvas id="syncStatusChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Records by Entity Bar Chart -->
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title">
              <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
              Registros por Entidad
              <div class="badge badge-ghost badge-sm">7 días</div>
            </h3>
            <div class="relative" style="height: 300px;">
              <canvas id="recordsByEntityChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Syncs per Day Line Chart -->
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow lg:col-span-2">
          <div class="card-body">
            <h3 class="card-title">
              <i data-lucide="trending-up" class="w-5 h-5"></i>
              Sincronizaciones por Día
              <div class="badge badge-ghost badge-sm">30 días</div>
            </h3>
            <div class="relative" style="height: 300px;">
              <canvas id="syncsPerDayChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Load Chart.js from CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  // Initialize charts
  let syncStatusChart, recordsByEntityChart, syncsPerDayChart;

  async function loadDashboardStats() {
    try {
      const response = await fetch('/api/dashboard/stats');
      const result = await response.json();

      if (result.success && result.data) {
        const stats = result.data;

        // Update status cards (if we have the data)
        // ... (cards are currently static, could be enhanced)

        // Create/Update charts
        createSyncStatusChart(stats.syncStatus || {});
        createRecordsByEntityChart(stats.recordsByEntity || {});
        createSyncsPerDayChart(stats.syncsPerDay || []);
      }
    } catch (error) {
      console.error('Error loading dashboard stats:', error);
    }
  }

  function createSyncStatusChart(data) {
    const ctx = document.getElementById('syncStatusChart');
    if (!ctx) return;

    if (syncStatusChart) {
      syncStatusChart.destroy();
    }

    const chartData = {
      labels: ['Exitosas', 'Fallidas', 'Parciales'],
      datasets: [{
        data: [
          data.success || 0,
          data.failed || 0,
          data.partial || 0
        ],
        backgroundColor: [
          'rgb(34, 197, 94)',   // green-500
          'rgb(239, 68, 68)',   // red-500
          'rgb(234, 179, 8)'    // yellow-500
        ],
        borderWidth: 0
      }]
    };

    syncStatusChart = new Chart(ctx, {
      type: 'doughnut',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return `${label}: ${value} (${percentage}%)`;
              }
            }
          }
        }
      }
    });
  }

  function createRecordsByEntityChart(data) {
    const ctx = document.getElementById('recordsByEntityChart');
    if (!ctx) return;

    if (recordsByEntityChart) {
      recordsByEntityChart.destroy();
    }

    const chartData = {
      labels: ['Artículos', 'Comprobantes', 'Pagos'],
      datasets: [{
        label: 'Registros Enviados',
        data: [
          data.articulo || 0,
          data.comprobante || 0,
          data.pago || 0
        ],
        backgroundColor: [
          'rgb(59, 130, 246)',   // blue-500
          'rgb(168, 85, 247)',   // purple-500
          'rgb(236, 72, 153)'    // pink-500
        ],
        borderWidth: 0
      }]
    };

    recordsByEntityChart = new Chart(ctx, {
      type: 'bar',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  }

  function createSyncsPerDayChart(data) {
    const ctx = document.getElementById('syncsPerDayChart');
    if (!ctx) return;

    if (syncsPerDayChart) {
      syncsPerDayChart.destroy();
    }

    // Ensure data is an array
    const days = Array.isArray(data) ? data : [];

    const chartData = {
      labels: days.map(d => {
        const date = new Date(d.date);
        return date.toLocaleDateString('es-AR', { month: 'short', day: 'numeric' });
      }),
      datasets: [
        {
          label: 'Exitosas',
          data: days.map(d => d.success || 0),
          borderColor: 'rgb(34, 197, 94)',
          backgroundColor: 'rgba(34, 197, 94, 0.1)',
          tension: 0.3,
          fill: true
        },
        {
          label: 'Fallidas',
          data: days.map(d => d.failed || 0),
          borderColor: 'rgb(239, 68, 68)',
          backgroundColor: 'rgba(239, 68, 68, 0.1)',
          tension: 0.3,
          fill: true
        }
      ]
    };

    syncsPerDayChart = new Chart(ctx, {
      type: 'line',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false
        },
        plugins: {
          legend: {
            position: 'bottom'
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  }

  // Load stats on page load
  loadDashboardStats();

  // Refresh stats every 60 seconds
  setInterval(loadDashboardStats, 60000);
</script>
