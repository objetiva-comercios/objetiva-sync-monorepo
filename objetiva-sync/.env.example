# =====================================================================
# OBJETIVA SYNC - CONFIGURACIÓN DE ENTORNO
# =====================================================================

# =====================================================================
# REQUERIDO (para deployment)
# =====================================================================

# Puerto del servidor (dashboard y API de sincronización)
PORT=3000

# Entorno de ejecución (development, production, test)
NODE_ENV=production

# Ruta del archivo de base de datos SQLite (relativa a la raíz del proyecto)
DATABASE_PATH=./database/objetiva-sync.db

# =====================================================================
# AUTO-GENERADAS (dejar vacío para primera ejecución)
# =====================================================================

# Clave de encriptación para datos sensibles (32+ caracteres hex)
# Se genera automáticamente en el primer arranque si está vacía
# Para generar manualmente: openssl rand -hex 32
ENCRYPTION_KEY=

# Secreto para sesiones del dashboard (32+ caracteres hex)
# Se genera automáticamente en el primer arranque si está vacía
# Para generar manualmente: openssl rand -hex 32
SESSION_SECRET=

# =====================================================================
# OPCIONAL - APLICACIÓN
# =====================================================================

# Nombre de la aplicación mostrado en el dashboard
APP_NAME=Objetiva Sync

# Contraseña inicial del administrador (solo se usa en el primer arranque para crear el usuario admin)
ADMIN_PASSWORD=cambiar123

# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# Ruta del archivo de log
LOG_FILE=./logs/sync.log

# =====================================================================
# OPCIONAL - API REMOTA (configurado via dashboard, puede pre-configurarse aquí)
# =====================================================================

# URL del gateway, ej: https://sync-gateway.example.com
# REMOTE_API_URL=

# Usuario para autenticación en el gateway
# REMOTE_API_USERNAME=

# Contraseña para autenticación en el gateway
# REMOTE_API_PASSWORD=

# =====================================================================
# OPCIONAL - CONFIGURACIÓN DE SINCRONIZACIÓN (configurado via dashboard, puede pre-configurarse aquí)
# =====================================================================

# Intervalo de sincronización automática en minutos
# SYNC_INTERVAL_MINUTES=30

# Cantidad de registros por lote de sincronización
# BATCH_SIZE=100

# =====================================================================
# OPCIONAL - VALIDACIÓN DE ESQUEMAS DEL GATEWAY
# =====================================================================

# URL del gateway para validación/regeneración de esquemas
# GATEWAY_URL=

# Secreto JWT compartido (debe coincidir con JWT_SECRET del gateway para validación de esquemas)
# JWT_SECRET=

# TTL del caché de esquemas en milisegundos (por defecto: 1 hora = 3600000ms)
# SCHEMA_CACHE_TTL_MS=3600000
