{
  "name": "objetiva-sync",
  "version": "1.0.0",
  "description": "Sincronizador unidireccional de datos desde ERPs a backend centralizado",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "service:install": "node scripts/install-service.js",
    "service:uninstall": "node scripts/uninstall-service.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "tsx tests/e2e/real-sync-test.ts",
    "test:e2e:articulos": "tsx tests/e2e/real-sync-test.ts articulos",
    "test:e2e:cabecera": "tsx tests/e2e/real-sync-test.ts comprobantes_cabecera",
    "test:e2e:detalle": "tsx tests/e2e/real-sync-test.ts comprobantes_detalle",
    "test:e2e:pagos": "tsx tests/e2e/real-sync-test.ts comprobantes_pagos",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "sync",
    "erp",
    "data-synchronization",
    "sql-server",
    "fastify"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/view": "^10.0.1",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.7.0",
    "cls-rtracer": "^2.6.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "ejs": "^3.1.10",
    "fast-jwt": "^6.1.0",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "5.7.4",
    "msnodesqlv8": "^5.1.3",
    "mssql": "^11.0.1",
    "node-cron": "^3.0.3",
    "pg": "^8.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^12.0.0",
    "undici": "^7.2.2",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ejs": "^3.1.5",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
