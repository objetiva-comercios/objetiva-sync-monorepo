# Test Environment Variables
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Test database (uses in-memory SQLite)
DATABASE_PATH=:memory:

# Test credentials
ADMIN_PASSWORD=test-admin-password-123
SESSION_SECRET=test-session-secret-32-chars-long-minimum
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Test ERP connection (not used in unit tests)
ERP_HOST=localhost
ERP_PORT=1433
ERP_DATABASE=test_erp
ERP_USER=test_user
ERP_PASSWORD=test_password

# Test API connection (not used in unit tests)
API_BASE_URL=http://localhost:3000
API_USERNAME=test_api_user
API_PASSWORD=test_api_password
# PostgreSQL test configuration (optional - for integration tests)
# Uncomment and set these to run PostgreSQL integration tests
# POSTGRES_TEST_HOST=localhost
# POSTGRES_TEST_PORT=5432
# POSTGRES_TEST_DATABASE=postgres
# POSTGRES_TEST_USER=postgres
# POSTGRES_TEST_PASSWORD=postgres
