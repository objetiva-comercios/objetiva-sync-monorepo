{
  "name": "objetiva-sync-gateway",
  "version": "1.0.0",
  "description": "API Gateway para recibir datos del sincronizador Objetiva Sync",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore 'prisma/schema.prisma' --ignore 'shared/schemas/**' src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "regenerate-schemas": "tsx scripts/regenerate-schemas.ts",
    "regenerate-schemas:dry-run": "tsx scripts/regenerate-schemas.ts --dry-run"
  },
  "keywords": [
    "fastify",
    "prisma",
    "sync",
    "gateway",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^7.2.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "diff": "^8.0.3",
    "exponential-backoff": "^3.1.3",
    "fastify": "^4.28.1",
    "pg": "^8.17.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.16.0",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.2.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
