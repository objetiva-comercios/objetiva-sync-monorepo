generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Articulo {
  sku String? @db.Text
  codigo String? @db.Text
  codigo_barras String? @db.Text
  codigo_equivalencia String? @db.Text
  nombre String? @db.Text
  nombre_corto String? @db.Text
  descripcion String? @db.Text
  descripcion_web String? @db.Text
  rubro String? @db.Text
  subrubro String? @db.Text
  objeto String? @db.Text
  adjetivo String? @db.Text
  marca String? @db.Text
  modelo String? @db.Text
  talle String? @db.Text
  color String? @db.Text
  material String? @db.Text
  presentacion String? @db.Text
  medida String? @db.Text
  prop_aux_1 String? @db.Text
  prop_aux_2 String? @db.Text
  prop_aux_3 String? @db.Text
  prop_aux_4 String? @db.Text
  prop_aux_5 String? @db.Text
  precio Decimal? @db.Decimal(10, 2)
  costo Decimal? @db.Decimal(10, 2)
  unidades Int? @default(0)
  imagenes_producto String[] @default([]) @db.Text
  imagenes_etiqueta String[] @default([]) @db.Text
  etiquetas_ocr String[] @default([]) @db.Text
  json_articulo Json? @default("{}") @db.JsonB
  activo Boolean? @default(true)
  observaciones String? @db.Text
  creado DateTime? @default(now()) @db.Timestamp(6)
  actualizado DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  erp_id String? @db.Text
  erp_codigo String @id @db.Text
  erp_nombre String @db.Text
  erp_precio Decimal? @db.Decimal(10, 2)
  erp_costo Decimal? @db.Decimal(10, 2)
  erp_unidades Int? @default(0)
  erp_datos Json? @default("{}") @db.JsonB
  erp_creado DateTime? @db.Timestamp(6)
  erp_actualizado DateTime? @db.Timestamp(6)
  erp_sincronizado Boolean? @default(false)
  erp_fecha_sync DateTime? @db.Timestamp(6)
  origin_source String? @db.Text
  origin_sync_id String? @db.Text
  origin_synced_at DateTime? @db.Timestamp(6)
  @@index([activo], map: "idx_articulos_activo")
  @@index([codigo_barras], map: "idx_articulos_codigo_barras")
  @@index([codigo_equivalencia], map: "idx_articulos_codigo_equivalencia")
  @@index([erp_id], map: "idx_articulos_erp_id")
  @@index([marca], map: "idx_articulos_marca")
  @@index([objeto], map: "idx_articulos_objeto")
  @@index([rubro, subrubro], map: "idx_articulos_rubro_subrubro")
  @@index([origin_source], map: "idx_articulos_origin_source")
  @@index([origin_synced_at], map: "idx_articulos_origin_synced_at")
  @@map("articulos")
}

model ComprobanteCabecera {
  operacion String @db.Text
  formulario String @db.Text
  numero String @db.Text
  fecha DateTime? @db.Timestamp(6)
  tercero_tipo String? @db.Text
  tercero_nombre String? @db.Text
  tercero_documento String? @db.Text
  tercero_direccion String? @db.Text
  tercero_datos Json? @default("{}") @db.JsonB
  cantidad_items Int? @default(0)
  total_bruto Decimal @db.Decimal(12, 2)
  total_descuentos Decimal @default(0) @db.Decimal(12, 2)
  total_neto Decimal @db.Decimal(12, 2)
  total_iva Decimal @db.Decimal(12, 2)
  total_venta Decimal @default(0) @db.Decimal(12, 2)
  total_intereses_financieros Decimal? @default(0) @db.Decimal(12, 2)
  total_cobrado Decimal? @db.Decimal(12, 2)
  activo Boolean @default(true)
  observaciones String? @db.Text
  creado DateTime @default(now()) @db.Timestamp(6)
  actualizado DateTime @default(now()) @updatedAt @db.Timestamp(6)
  erp_id String? @db.Text
  erp_operacion String @db.Text
  erp_formulario String @db.Text
  erp_numero String @db.Text
  erp_datos Json? @default("{}") @db.JsonB
  erp_creado DateTime? @db.Timestamp(6)
  erp_actualizado DateTime? @db.Timestamp(6)
  erp_sincronizado Boolean? @default(false)
  erp_fecha_sync DateTime? @db.Timestamp(6)
  origin_source String? @db.Text
  origin_sync_id String? @db.Text
  origin_synced_at DateTime? @db.Timestamp(6)

  @@id([operacion, formulario, numero])
  @@map("comprobantes_cabecera")
}

model ComprobanteDetalle {
  comprobante_operacion String @db.Text
  comprobante_formulario String @db.Text
  comprobante_numero String @db.Text
  linea_numero Int
  articulo_codigo String? @db.Text
  articulo_nombre String? @db.Text
  unidades Decimal @db.Decimal(10, 3)
  precio_unitario Decimal @db.Decimal(12, 4)
  importe_bruto Decimal @db.Decimal(12, 2)
  porc_descuento Decimal? @db.Decimal(5, 2)
  importe_descuento Decimal @default(0) @db.Decimal(12, 2)
  importe_neto Decimal @db.Decimal(12, 2)
  alicuota_iva Decimal @db.Decimal(5, 2)
  importe_iva Decimal @db.Decimal(12, 2)
  importe_total Decimal @db.Decimal(12, 2)
  observaciones String? @db.Text
  creado DateTime @default(now()) @db.Timestamp(6)
  actualizado DateTime @default(now()) @updatedAt @db.Timestamp(6)
  erp_operacion String @db.Text
  erp_formulario String @db.Text
  erp_numero String @db.Text
  erp_datos Json? @default("{}") @db.JsonB
  erp_creado DateTime? @db.Timestamp(6)
  erp_actualizado DateTime? @db.Timestamp(6)
  erp_sincronizado Boolean? @default(false)
  erp_fecha_sync DateTime? @db.Timestamp(6)
  origin_source String? @db.Text
  origin_sync_id String? @db.Text
  origin_synced_at DateTime? @db.Timestamp(6)

  @@id([comprobante_operacion, comprobante_formulario, comprobante_numero, linea_numero])
  @@map("comprobantes_detalle")
}

model ComprobantePagos {
  comprobante_operacion String @db.Text
  comprobante_formulario String @db.Text
  comprobante_numero String @db.Text
  linea_numero Int
  medio String @db.Text
  monto Decimal @db.Decimal(12, 2)
  moneda String @default("ARS") @db.Text
  tarjeta_marca String? @db.Text
  tarjeta_cuotas Int? @default(1)
  tarjeta_recargo Decimal? @default(0) @db.Decimal(12, 2)
  cheque_fecha_diferida DateTime? @db.Date
  fecha_vencimiento DateTime? @db.Date
  datos_extra Json? @default("{}") @db.JsonB
  referencia String? @db.Text
  observaciones String? @db.Text
  creado DateTime @default(now()) @db.Timestamp(6)
  actualizado DateTime @default(now()) @updatedAt @db.Timestamp(6)
  erp_operacion String @db.Text
  erp_formulario String @db.Text
  erp_numero String @db.Text
  erp_datos Json? @default("{}") @db.JsonB
  erp_creado DateTime? @db.Timestamp(6)
  erp_actualizado DateTime? @db.Timestamp(6)
  erp_sincronizado Boolean? @default(false)
  erp_fecha_sync DateTime? @db.Timestamp(6)
  origin_source String? @db.Text
  origin_sync_id String? @db.Text
  origin_synced_at DateTime? @db.Timestamp(6)

  @@id([comprobante_operacion, comprobante_formulario, comprobante_numero, linea_numero])
  @@map("comprobantes_pagos")
}

