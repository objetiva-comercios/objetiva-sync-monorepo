// Schema Prisma para objetiva-sync-gateway
// Mapea EXACTAMENTE a las tablas PostgreSQL existentes
// NO crea tablas, solo las usa

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabla: public.articulos
model Articulo {
  id                    BigInt    @id @default(autoincrement())

  // Campos REQUERIDOS (NOT NULL en Postgres)
  erpCodigo             String    @map("erp_codigo") @db.Text

  // Identificadores opcionales
  sku                   String?   @unique @db.Text
  codigo                String?   @db.Text
  codigoBarras          String?   @map("codigo_barras") @db.Text
  erpId                 String?   @map("erp_id") @db.Text
  codigoEquivalencia    String?   @map("codigo_equivalencia") @db.Text

  // Información básica
  nombre                String?   @db.Text
  nombreCorto           String?   @map("nombre_corto") @db.Text
  descripcion           String?   @db.Text
  descripcionWeb        String?   @map("descripcion_web") @db.Text

  // Clasificación
  rubro                 String?   @db.Text
  subrubro              String?   @db.Text
  objeto                String?   @db.Text // 'producto' | 'servicio'

  // Propiedades del producto
  marca                 String?   @db.Text
  modelo                String?   @db.Text
  adjetivo              String?   @db.Text
  talle                 String?   @db.Text
  color                 String?   @db.Text
  material              String?   @db.Text
  presentacion          String?   @db.Text
  medida                String?   @db.Text

  // Propiedades auxiliares
  propAux1              String?   @map("prop_aux_1") @db.Text
  propAux2              String?   @map("prop_aux_2") @db.Text
  propAux3              String?   @map("prop_aux_3") @db.Text
  propAux4              String?   @map("prop_aux_4") @db.Text
  propAux5              String?   @map("prop_aux_5") @db.Text

  // Precios e inventario
  precio                Decimal?  @db.Decimal(10, 2)
  costo                 Decimal?  @db.Decimal(10, 2)
  unidades              Int       @default(0)

  // Imágenes y OCR
  imagenesProducto      String[]  @default([]) @map("imagenes_producto") @db.Text
  imagenesEtiqueta      String[]  @default([]) @map("imagenes_etiqueta") @db.Text
  etiquetasOcr          String[]  @default([]) @map("etiquetas_ocr") @db.Text

  // Metadata
  jsonArticulo          Json      @default("{}") @map("json_articulo") @db.JsonB
  erpExtra              String?   @map("erp_extra") @db.Text
  erpSincronizado       Boolean   @default(false) @map("erp_sincronizado")
  erpFechaSync          DateTime? @map("erp_fecha_sync") @db.Timestamp(6)

  // Estado
  activo                Boolean   @default(true)
  observaciones         String?   @db.Text
  creado                DateTime  @default(now()) @db.Timestamp(6)
  actualizado           DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@map("articulos")
  @@index([activo])
  @@index([codigo])
  @@index([codigoBarras], map: "idx_articulos_codigo_barras")
  @@index([codigoEquivalencia], map: "idx_articulos_codigo_equivalencia")
  @@index([erpCodigo], map: "idx_articulos_erp_codigo")
  @@index([erpId], map: "idx_articulos_erp_id")
  @@index([marca])
  @@index([objeto])
  @@index([rubro, subrubro], map: "idx_articulos_rubro_subrubro")
}

// Tabla: public.comprobantes_cabecera
// Tabla: public.comprobantes_cabecera
model ComprobanteCabecera {
  id                    BigInt    @id @default(autoincrement())

  // Clave compuesta normalizada (NOT NULL en DB)
  operacion             String    @map("operacion") @db.Text
  formulario            String    @map("formulario") @db.Text
  numero                String    @map("numero") @db.Text

  // Valores originales del ERP - Metadata (NULL en DB)
  erpOperacion          String?   @map("erp_operacion") @db.Text
  erpFormulario         String?   @map("erp_formulario") @db.Text
  erpNumero             String?   @map("erp_numero") @db.Text

  // Datos del comprobante
  fecha                 DateTime? @db.Timestamp(6)
  periodo               String?   @db.Text

  // Tercero (cliente/proveedor)
  terceroTipo           String?   @map("tercero_tipo") @db.Text
  terceroNombre         String?   @map("tercero_nombre") @db.Text
  terceroDocumento      String?   @map("tercero_documento") @db.Text
  terceroDireccion      String?   @map("tercero_direccion") @db.Text
  terceroDatos          Json      @default("{}") @map("tercero_datos") @db.JsonB

  // Totales
  cantidadItems         Int       @default(0) @map("cantidad_items")
  subtotal              Decimal?  @db.Decimal(12, 2)
  totalImpuestos        Decimal?  @map("total_impuestos") @db.Decimal(12, 2)
  totalDescuentos       Decimal?  @map("total_descuentos") @db.Decimal(12, 2)
  total                 Decimal   @default(0) @db.Decimal(12, 2)

  // Metadata ERP
  erpId                 String?   @map("erp_id") @db.Text
  erpDatos              Json      @default("{}") @map("erp_datos") @db.JsonB
  erpSincronizado       Boolean   @default(false) @map("erp_sincronizado")
  erpFechaSync          DateTime? @map("erp_fecha_sync") @db.Timestamp(6)

  // Estado
  observaciones         String?   @db.Text
  activo                Boolean   @default(true)
  creado                DateTime  @default(now()) @db.Timestamp(6)
  actualizado           DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  // Relaciones
  detalles              ComprobanteDetalle[]
  pagos                 ComprobantePagos[]

  @@map("comprobantes_cabecera")
  @@unique([operacion, formulario, numero], name: "idx_comprobante_erp_unique")
  @@index([creado], map: "idx_comprobantes_cabecera_creado")
  @@index([erpId], map: "idx_comprobantes_cabecera_erp_id")
  @@index([fecha], map: "idx_comprobantes_cabecera_fecha")
  @@index([periodo], map: "idx_comprobantes_cabecera_periodo")
  @@index([terceroDocumento], map: "idx_comprobantes_cabecera_tercero")
}

// Tabla: public.comprobantes_detalle
model ComprobanteDetalle {
  id                    BigInt              @id @default(autoincrement())

  // Clave compuesta normalizada
  operacion             String              @map("comprobante_operacion") @db.Text
  formulario            String              @map("comprobante_formulario") @db.Text
  numero                String              @map("comprobante_numero") @db.Text

  // Metadata ERP
  erpOperacion          String?             @map("erp_operacion") @db.Text
  erpFormulario         String?             @map("erp_formulario") @db.Text
  erpNumero             String?             @map("erp_numero") @db.Text

  comprobanteId         BigInt?             @map("comprobante_id") // Opcional - se llena después de vincular
  lineaNumero           Int                 @default(1) @map("linea_numero")
  articuloId            BigInt?             @map("articulo_id")
  codigoArticulo        String?             @map("articulo_codigo") @db.Text
  nombreArticulo        String?             @map("articulo_nombre") @db.Text
  unidades              Decimal             @db.Decimal(10, 3)
  precioUnitario        Decimal?            @map("precio_unitario") @db.Decimal(12, 4)
  subtotal              Decimal?            @db.Decimal(12, 2)
  impuesto1Nombre       String?             @map("impuesto_1_nombre") @db.Text
  impuesto1Porcentaje   Decimal?            @map("impuesto_1_porcentaje") @db.Decimal(5, 2)
  impuesto1Monto        Decimal?            @map("impuesto_1_monto") @db.Decimal(12, 2)
  impuesto2Nombre       String?             @map("impuesto_2_nombre") @db.Text
  impuesto2Porcentaje   Decimal?            @map("impuesto_2_porcentaje") @db.Decimal(5, 2)
  impuesto2Monto        Decimal?            @map("impuesto_2_monto") @db.Decimal(12, 2)
  impuesto3Nombre       String?             @map("impuesto_3_nombre") @db.Text
  impuesto3Porcentaje   Decimal?            @map("impuesto_3_porcentaje") @db.Decimal(5, 2)
  impuesto3Monto        Decimal?            @map("impuesto_3_monto") @db.Decimal(12, 2)
  descuentoPorcentaje   Decimal?            @map("descuento_porcentaje") @db.Decimal(5, 2)
  descuentoMonto        Decimal?            @map("descuento_monto") @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  erpDatos              Json                @default("{}") @map("erp_datos") @db.JsonB
  observaciones         String?             @db.Text
  creado                DateTime            @default(now()) @db.Timestamp(6)
  actualizado           DateTime            @default(now()) @updatedAt @db.Timestamp(6)

  // Relaciones (opcionales)
  comprobante           ComprobanteCabecera? @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@map("comprobantes_detalle")
  @@index([erpOperacion, erpFormulario, erpNumero], map: "idx_detalle_erp_comprobante")
  @@index([articuloId], map: "idx_comprobantes_detalle_articulo")
  @@index([codigoArticulo], map: "idx_comprobantes_detalle_codigo")
  @@index([comprobanteId], map: "idx_comprobantes_detalle_comprobante")
}

// Tabla: public.comprobantes_pagos
model ComprobantePagos {
  id                    BigInt              @id @default(autoincrement())

  // Clave compuesta normalizada
  operacion             String              @map("comprobante_operacion") @db.Text
  formulario            String              @map("comprobante_formulario") @db.Text
  numero                String              @map("comprobante_numero") @db.Text

  // Metadata ERP
  erpOperacion          String?             @map("erp_operacion") @db.Text
  erpFormulario         String?             @map("erp_formulario") @db.Text
  erpNumero             String?             @map("erp_numero") @db.Text

  comprobanteId         BigInt?             @map("comprobante_id") // Opcional - se llena después de vincular
  lineaNumero           Int                 @default(1) @map("linea_numero")
  metodoPago            String              @map("metodo_pago") @db.Text // 'Efectivo', 'Tarjeta', 'Cheque', etc
  monto                 Decimal             @db.Decimal(12, 2)
  moneda                String              @default("ARS") @db.Text
  tarjetaMarca          String?             @map("tarjeta_marca") @db.Text
  tarjetaCuotas         Int?                @map("tarjeta_cuotas")
  tarjetaRecargo        Decimal?            @map("tarjeta_recargo") @db.Decimal(12, 2)
  chequeFechaDiferida   DateTime?           @map("cheque_fecha_diferida") @db.Timestamptz
  fechaVencimiento      DateTime?           @map("fecha_vencimiento") @db.Timestamptz
  datosExtra            Json?               @map("datos_extra") @db.JsonB
  referencia            String?             @db.Text
  observaciones         String?             @db.Text
  erpDatos              Json?               @map("erp_datos") @db.JsonB
  activo                Boolean             @default(true)
  creado                DateTime            @default(now()) @map("created_at") @db.Timestamptz
  actualizado           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones (opcionales)
  comprobante           ComprobanteCabecera? @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@map("comprobantes_pagos")
  @@index([erpOperacion, erpFormulario, erpNumero], map: "idx_pago_erp_comprobante")
  @@index([chequeFechaDiferida], map: "idx_pagos_cheque_diferido")
  @@index([comprobanteId], map: "idx_pagos_comprobante")
  @@index([metodoPago], map: "idx_pagos_medio")
  @@index([tarjetaCuotas], map: "idx_pagos_tarjeta_cuotas")
  @@index([tarjetaMarca], map: "idx_pagos_tarjeta_marca")
}
