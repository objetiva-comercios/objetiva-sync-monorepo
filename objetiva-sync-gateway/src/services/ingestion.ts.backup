import type { PrismaClient } from '@prisma/client'
import type {
  ArticuloInput,
  ComprobanteCabeceraInput,
  ComprobanteDetalleInput,
  ComprobantePagosInput
} from '../../shared/schemas/index.js'
import { logger } from '../lib/logger.js'

interface IngestionResult {
  inserted: number
  updated: number
  errors: Array<{
    index: number
    identifier: string
    error: string
    code: string
  }>
}

export class IngestionService {

  static async ingestArticulos(
    prisma: PrismaClient,
    articulos: ArticuloInput[]
  ): Promise<IngestionResult> {
    let inserted = 0
    let updated = 0
    const errors: IngestionResult['errors'] = []

    for (const [index, articulo] of articulos.entries()) {
      try {
        // Buscar artículo existente por erpCodigo (campo requerido)
        const existing = await prisma.articulo.findFirst({
          where: {
            erpCodigo: articulo.erp_codigo,
          }
        })

        if (existing) {
          await prisma.articulo.update({
            where: { id: existing.id },
            data: {
              // Campos REQUERIDOS (NOT NULL)
              erpCodigo: articulo.erp_codigo,

              // Identificadores opcionales
              sku: articulo.sku,
              codigo: articulo.codigo,
              codigoBarras: articulo.codigo_barras,
              erpId: articulo.erp_id,
              codigoEquivalencia: articulo.codigo_equivalencia,

              // Información básica
              nombre: articulo.nombre,
              nombreCorto: articulo.nombre_corto,
              descripcion: articulo.descripcion,
              descripcionWeb: articulo.descripcion_web,

              // Clasificación
              rubro: articulo.rubro,
              subrubro: articulo.subrubro,
              objeto: articulo.objeto,

              // Propiedades del producto
              marca: articulo.marca,
              modelo: articulo.modelo,
              adjetivo: articulo.adjetivo,
              talle: articulo.talle,
              color: articulo.color,
              material: articulo.material,
              presentacion: articulo.presentacion,
              medida: articulo.medida,

              // Propiedades auxiliares
              propAux1: articulo.prop_aux_1,
              propAux2: articulo.prop_aux_2,
              propAux3: articulo.prop_aux_3,
              propAux4: articulo.prop_aux_4,
              propAux5: articulo.prop_aux_5,

              // Precios e inventario
              precio: articulo.precio,
              costo: articulo.costo,
              unidades: articulo.unidades,

              // Imágenes y OCR
              imagenesProducto: articulo.imagenes_producto,
              imagenesEtiqueta: articulo.imagenes_etiqueta,
              etiquetasOcr: articulo.etiquetas_ocr,

              // Metadata
              jsonArticulo: articulo.json_articulo,
              erpExtra: articulo.erp_extra,

              // Estado
              activo: articulo.activo,
              observaciones: articulo.observaciones,

              actualizado: new Date()
            }
          })
          updated++
          logger.debug({ sku: articulo.sku }, 'Artículo actualizado')
        } else {
          await prisma.articulo.create({
            data: {
              // Campos REQUERIDOS (NOT NULL)
              erpCodigo: articulo.erp_codigo,

              // Identificadores opcionales
              sku: articulo.sku,
              codigo: articulo.codigo,
              codigoBarras: articulo.codigo_barras,
              erpId: articulo.erp_id,
              codigoEquivalencia: articulo.codigo_equivalencia,

              // Información básica
              nombre: articulo.nombre,
              nombreCorto: articulo.nombre_corto,
              descripcion: articulo.descripcion,
              descripcionWeb: articulo.descripcion_web,

              // Clasificación
              rubro: articulo.rubro,
              subrubro: articulo.subrubro,
              objeto: articulo.objeto,

              // Propiedades del producto
              marca: articulo.marca,
              modelo: articulo.modelo,
              adjetivo: articulo.adjetivo,
              talle: articulo.talle,
              color: articulo.color,
              material: articulo.material,
              presentacion: articulo.presentacion,
              medida: articulo.medida,

              // Propiedades auxiliares
              propAux1: articulo.prop_aux_1,
              propAux2: articulo.prop_aux_2,
              propAux3: articulo.prop_aux_3,
              propAux4: articulo.prop_aux_4,
              propAux5: articulo.prop_aux_5,

              // Precios e inventario
              precio: articulo.precio,
              costo: articulo.costo,
              unidades: articulo.unidades,

              // Imágenes y OCR
              imagenesProducto: articulo.imagenes_producto,
              imagenesEtiqueta: articulo.imagenes_etiqueta,
              etiquetasOcr: articulo.etiquetas_ocr,

              // Metadata
              jsonArticulo: articulo.json_articulo,
              erpExtra: articulo.erp_extra,

              // Estado
              activo: articulo.activo,
              observaciones: articulo.observaciones
            }
          })
          inserted++
          logger.debug({ sku: articulo.sku }, 'Artículo insertado')
        }

      } catch (error) {
        logger.error({ error, articulo }, 'Error al procesar artículo')
        errors.push({
          index,
          identifier: articulo.sku || articulo.codigo || `item-${index}`,
          error: error instanceof Error ? error.message : 'Error desconocido',
          code: 'INGESTION_ERROR'
        })
      }
    }

    logger.info({ inserted, updated, errors: errors.length }, 'Artículos procesados')
    return { inserted, updated, errors }
  }

  /**
   * Ingesta de comprobantes cabecera
   * Cada cabecera viene con su clave compuesta (operacion, formulario, numero)
   * Los detalles y pagos se vincularán después usando esta clave
   */
  static async ingestComprobantesCabecera(
    prisma: PrismaClient,
    comprobantes: ComprobanteCabeceraInput[]
  ): Promise<IngestionResult> {
    let inserted = 0
    let updated = 0
    const errors: IngestionResult['errors'] = []

    for (const [index, comp] of comprobantes.entries()) {
      try {
        // Buscar por clave compuesta única (operacion, formulario, numero)
        const existing = await prisma.comprobanteCabecera.findUnique({
          where: {
            idx_comprobante_erp_unique: {
              operacion: comp.operacion,
              formulario: comp.formulario,
              numero: comp.numero
            }
          }
        })

        const dataPayload = {
          // Clave compuesta normalizada (NOT NULL)
          operacion: comp.operacion,
          formulario: comp.formulario,
          numero: comp.numero,

          // Valores originales del ERP - Metadata (NULL)
          erpOperacion: comp.erp_operacion,
          erpFormulario: comp.erp_formulario,
          erpNumero: comp.erp_numero,

          // Datos del comprobante
          fecha: comp.fecha ? new Date(comp.fecha) : undefined,
          periodo: comp.periodo,

          // Tercero
          terceroTipo: comp.tercero_tipo,
          terceroNombre: comp.tercero_nombre,
          terceroDocumento: comp.tercero_documento,
          terceroDireccion: comp.tercero_direccion,
          terceroDatos: comp.tercero_datos,

          // Totales
          cantidadItems: comp.cantidad_items,
          subtotal: comp.subtotal,
          totalImpuestos: comp.total_impuestos,
          totalDescuentos: comp.total_descuentos,
          total: comp.total,

          // Metadata ERP
          erpId: comp.erp_id,
          erpDatos: comp.erp_datos,
          erpSincronizado: comp.erp_sincronizado,
          erpFechaSync: comp.erp_fecha_sync ? new Date(comp.erp_fecha_sync) : undefined,

          // Estado
          activo: comp.activo,
          observaciones: comp.observaciones
        }

        if (existing) {
          await prisma.comprobanteCabecera.update({
            where: { id: existing.id },
            data: {
              ...dataPayload,
              actualizado: new Date()
            }
          })
          updated++
          logger.debug({ key: `${comp.operacion}/${comp.formulario}/${comp.numero}` }, 'Comprobante cabecera actualizado')
        } else {
          await prisma.comprobanteCabecera.create({
            data: dataPayload
          })
          inserted++
          logger.debug({ key: `${comp.operacion}/${comp.formulario}/${comp.numero}` }, 'Comprobante cabecera insertado')
        }

      } catch (error) {
        const errorMessage = error instanceof Error ? error.message : 'Error desconocido'
        let errorCode = 'INGESTION_ERROR'

        // Mejorar mensaje de error según el tipo
        if (errorMessage.includes('Unique constraint failed')) {
          errorCode = 'DUPLICATE_KEY'
        } else if (errorMessage.includes('Foreign key constraint failed')) {
          errorCode = 'FOREIGN_KEY_ERROR'
        } else if (errorMessage.includes('Required') || errorMessage.includes('Expected')) {
          errorCode = 'VALIDATION_ERROR'
        } else if (errorMessage.includes('date') || errorMessage.includes('Date')) {
          errorCode = 'DATE_FORMAT_ERROR'
        }

        const detailedError = `[${errorCode}] ${errorMessage} | Clave: ${comp.operacion}/${comp.formulario}/${comp.numero}`

        logger.error({
          error: errorMessage,
          errorCode,
          key: `${comp.operacion}/${comp.formulario}/${comp.numero}`
        }, 'Error al procesar comprobante cabecera')

        errors.push({
          index,
          identifier: `${comp.operacion}/${comp.formulario}/${comp.numero}`,
          error: detailedError,
          code: errorCode
        })
      }
    }

    logger.info({ inserted, updated, errors: errors.length }, 'Comprobantes cabecera procesados')
    return { inserted, updated, errors }
  }

  /**
   * Ingesta de comprobantes detalle
   * Los detalles se vinculan a la cabecera mediante la clave compuesta
   */
  static async ingestComprobantesDetalle(
    prisma: PrismaClient,
    detalles: ComprobanteDetalleInput[]
  ): Promise<IngestionResult> {
    let inserted = 0
    let updated = 0
    const errors: IngestionResult['errors'] = []

    for (const [index, det] of detalles.entries()) {
      try {
        // NOTA: No validamos si existe la cabecera antes de insertar el detalle.
        // Los detalles son independientes y se relacionan por clave compuesta (operacion/formulario/numero).
        // La relación se resolverá automáticamente cuando ambas entidades existan en la base de datos.

        // Buscar la cabecera (opcional - no es obligatorio que exista)
        const cabecera = await prisma.comprobanteCabecera.findUnique({
          where: {
            idx_comprobante_erp_unique: {
              operacion: det.operacion,
              formulario: det.formulario,
              numero: det.numero
            }
          }
        })

        // Buscar detalle existente por clave compuesta + línea número
        const existing = await prisma.comprobanteDetalle.findFirst({
          where: {
            operacion: det.operacion,
            formulario: det.formulario,
            numero: det.numero,
            lineaNumero: det.linea_numero
          }
        })

        const dataPayload = {
          // Clave compuesta
          operacion: det.operacion,
          formulario: det.formulario,
          numero: det.numero,

          // Metadata ERP
          erpOperacion: det.erp_operacion,
          erpFormulario: det.erp_formulario,
          erpNumero: det.erp_numero,

          // Vinculación con cabecera (opcional - solo si existe)
          comprobanteId: cabecera?.id,

          // Datos del detalle
          lineaNumero: det.linea_numero,
          articuloId: det.articulo_id,
          codigoArticulo: det.codigo_articulo,
          nombreArticulo: det.nombre_articulo,
          unidades: det.unidades,
          precioUnitario: det.precio_unitario,
          subtotal: det.subtotal,

          // Impuestos
          impuesto1Nombre: det.impuesto_1_nombre,
          impuesto1Porcentaje: det.impuesto_1_porcentaje,
          impuesto1Monto: det.impuesto_1_monto,
          impuesto2Nombre: det.impuesto_2_nombre,
          impuesto2Porcentaje: det.impuesto_2_porcentaje,
          impuesto2Monto: det.impuesto_2_monto,
          impuesto3Nombre: det.impuesto_3_nombre,
          impuesto3Porcentaje: det.impuesto_3_porcentaje,
          impuesto3Monto: det.impuesto_3_monto,

          // Descuentos
          descuentoPorcentaje: det.descuento_porcentaje,
          descuentoMonto: det.descuento_monto,

          total: det.total,
          erpDatos: det.erp_datos,
          observaciones: det.observaciones
        }

        if (existing) {
          await prisma.comprobanteDetalle.update({
            where: { id: existing.id },
            data: {
              ...dataPayload,
              actualizado: new Date()
            }
          })
          updated++
          logger.debug(
            { erpNumero: det.erp_numero, lineaNumero: det.linea_numero },
            'Comprobante detalle actualizado'
          )
        } else {
          await prisma.comprobanteDetalle.create({
            data: dataPayload
          })
          inserted++
          logger.debug(
            { erpNumero: det.erp_numero, lineaNumero: det.linea_numero },
            'Comprobante detalle insertado'
          )
        }

      } catch (error) {
        const errorMessage = error instanceof Error ? error.message : 'Error desconocido'
        let errorCode = 'INGESTION_ERROR'

        // Clasificar tipo de error
        if (errorMessage.includes('Unique constraint failed')) {
          errorCode = 'DUPLICATE_KEY'
        } else if (errorMessage.includes('Foreign key constraint failed')) {
          errorCode = 'FOREIGN_KEY_ERROR'
        } else if (errorMessage.includes('Required') || errorMessage.includes('Expected')) {
          errorCode = 'VALIDATION_ERROR'
        } else if (errorMessage.includes('date') || errorMessage.includes('Date')) {
          errorCode = 'DATE_FORMAT_ERROR'
        }

        const detailedError = `[${errorCode}] ${errorMessage} | Detalle: ${det.erp_operacion}/${det.erp_formulario}/${det.erp_numero} L${det.linea_numero}`

        logger.error({
          error: errorMessage,
          errorCode,
          erpKey: `${det.erp_operacion}/${det.erp_formulario}/${det.erp_numero}`,
          lineaNumero: det.linea_numero
        }, 'Error al procesar comprobante detalle')

        errors.push({
          index,
          identifier: `${det.erp_operacion}/${det.erp_formulario}/${det.erp_numero} L${det.linea_numero}`,
          error: detailedError,
          code: errorCode
        })
      }
    }

    logger.info({ inserted, updated, errors: errors.length }, 'Comprobantes detalle procesados')
    return { inserted, updated, errors }
  }

  /**
   * Ingesta de comprobantes pagos
   * Los pagos se vinculan a la cabecera mediante la clave compuesta
   */
  static async ingestComprobantesPagos(
    prisma: PrismaClient,
    pagos: ComprobantePagosInput[]
  ): Promise<IngestionResult> {
    let inserted = 0
    let updated = 0
    const errors: IngestionResult['errors'] = []

    for (const [index, pago] of pagos.entries()) {
      try {
        // NOTA: No validamos si existe la cabecera antes de insertar el pago.
        // Los pagos son independientes y se relacionan por clave compuesta (operacion/formulario/numero).
        // La relación se resolverá automáticamente cuando ambas entidades existan en la base de datos.

        // Buscar la cabecera (opcional - no es obligatorio que exista)
        const cabecera = await prisma.comprobanteCabecera.findUnique({
          where: {
            idx_comprobante_erp_unique: {
              operacion: pago.operacion,
              formulario: pago.formulario,
              numero: pago.numero
            }
          }
        })

        // Buscar pago existente por clave compuesta + línea número
        const existing = await prisma.comprobantePagos.findFirst({
          where: {
            operacion: pago.operacion,
            formulario: pago.formulario,
            numero: pago.numero,
            lineaNumero: pago.linea_numero
          }
        })

        const dataPayload = {
          // Clave compuesta
          operacion: pago.operacion,
          formulario: pago.formulario,
          numero: pago.numero,

          // Metadata ERP
          erpOperacion: pago.erp_operacion,
          erpFormulario: pago.erp_formulario,
          erpNumero: pago.erp_numero,

          // Vinculación con cabecera (opcional - solo si existe)
          comprobanteId: cabecera?.id,

          // Datos del pago
          lineaNumero: pago.linea_numero,
          metodoPago: pago.metodo_pago,
          monto: pago.monto,
          moneda: pago.moneda,

          // Datos de tarjeta
          tarjetaMarca: pago.tarjeta_marca,
          tarjetaCuotas: pago.tarjeta_cuotas,
          tarjetaRecargo: pago.tarjeta_recargo,

          // Datos de cheque
          chequeFechaDiferida: pago.cheque_fecha_diferida ? new Date(pago.cheque_fecha_diferida) : null,

          // Fecha de vencimiento
          fechaVencimiento: pago.fecha_vencimiento ? new Date(pago.fecha_vencimiento) : null,

          // Datos flexibles
          datosExtra: pago.datos_extra,
          referencia: pago.referencia,
          observaciones: pago.observaciones,

          // Datos ERP
          erpDatos: pago.erp_datos,

          // Estado
          activo: pago.activo
        }

        if (existing) {
          await prisma.comprobantePagos.update({
            where: { id: existing.id },
            data: {
              ...dataPayload,
              actualizado: new Date()
            }
          })
          updated++
          logger.debug(
            { erpNumero: pago.erp_numero, lineaNumero: pago.linea_numero, metodoPago: pago.metodo_pago },
            'Comprobante pago actualizado'
          )
        } else {
          await prisma.comprobantePagos.create({
            data: dataPayload
          })
          inserted++
          logger.debug(
            { erpNumero: pago.erp_numero, lineaNumero: pago.linea_numero, metodoPago: pago.metodo_pago },
            'Comprobante pago insertado'
          )
        }

      } catch (error) {
        const errorMessage = error instanceof Error ? error.message : 'Error desconocido'
        let errorCode = 'INGESTION_ERROR'

        // Clasificar tipo de error
        if (errorMessage.includes('Unique constraint failed')) {
          errorCode = 'DUPLICATE_KEY'
        } else if (errorMessage.includes('Foreign key constraint failed')) {
          errorCode = 'FOREIGN_KEY_ERROR'
        } else if (errorMessage.includes('Required') || errorMessage.includes('Expected')) {
          errorCode = 'VALIDATION_ERROR'
        } else if (errorMessage.includes('date') || errorMessage.includes('Date')) {
          errorCode = 'DATE_FORMAT_ERROR'
        }

        const detailedError = `[${errorCode}] ${errorMessage} | Pago: ${pago.erp_operacion}/${pago.erp_formulario}/${pago.erp_numero} L${pago.linea_numero} - ${pago.metodo_pago}`

        logger.error({
          error: errorMessage,
          errorCode,
          erpKey: `${pago.erp_operacion}/${pago.erp_formulario}/${pago.erp_numero}`,
          lineaNumero: pago.linea_numero,
          metodoPago: pago.metodo_pago
        }, 'Error al procesar comprobante pago')

        errors.push({
          index,
          identifier: `${pago.erp_operacion}/${pago.erp_formulario}/${pago.erp_numero} L${pago.linea_numero}`,
          error: detailedError,
          code: errorCode
        })
      }
    }

    logger.info({ inserted, updated, errors: errors.length }, 'Comprobantes pagos procesados')
    return { inserted, updated, errors }
  }
}
