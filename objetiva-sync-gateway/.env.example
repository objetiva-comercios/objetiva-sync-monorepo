#####################################################################
# Objetiva Sync Gateway - Environment Variables
#####################################################################
# Copy this file to .env and configure all variables.
# NEVER commit .env to version control (contains secrets).
#####################################################################

# ===== SERVER =====

# Puerto del servidor (default: 3335)
PORT=3335

# Entorno de ejecución (development, production)
NODE_ENV=production

# Dirección de escucha
# 0.0.0.0 = todas las interfaces (para producción detrás de proxy)
# 127.0.0.1 = solo localhost (si nginx está en la misma máquina)
HOST=0.0.0.0

# ===== DATABASE =====

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/base_de_datos
#
# Bare-metal: usa localhost o la IP del servidor PostgreSQL
#   DATABASE_URL=postgresql://sync_user:mypassword@localhost:5432/objetiva_sync_gateway
#
# Docker: usa el nombre del contenedor o servicio de PostgreSQL, NO localhost.
# Si PostgreSQL corre en la red sanchez_docker_network con contenedor "postgres":
#   DATABASE_URL=postgresql://sync_user:mypassword@postgres:5432/objetiva_sync_gateway
#
DATABASE_URL=postgresql://user:password@localhost:5432/objetiva_db

# ===== JWT AUTHENTICATION =====

# Secret para firmar tokens JWT
# CRITICAL: Generar uno seguro con: openssl rand -hex 32
# Debe ser el mismo secret que usa el sincronizador para validar tokens
JWT_SECRET=change-me-to-random-64-char-hex-string

# Tiempo de expiración de tokens JWT en SEGUNDOS (not milliseconds!)
# IMPORTANT: Must be a NUMBER, not a string
# Default: 86400 = 24 horas
# Valores comunes: 3600 (1h), 43200 (12h), 86400 (24h), 604800 (7d)
JWT_EXPIRES_IN=86400

# ===== SYNC CLIENT AUTHENTICATION =====

# Usuario fijo para autenticación del sincronizador
# El cliente (objetiva-sync) usará estas credenciales para login
SYNC_USERNAME=admin

# Contraseña del sincronizador (texto plano)
# El servidor compara directamente contra este valor
SYNC_PASSWORD=change-me

# ===== LOGGING =====

# Nivel de logging (error, warn, info, debug, trace)
# Producción: info o warn
# Desarrollo: debug o trace
LOG_LEVEL=info

# ===== GATEWAY PUBLIC URL =====

# URL pública del gateway (necesaria para pairing en Phase 20)
# Formato: https://gateway.example.com o http://localhost:3335
# Configurada automáticamente por el wizard (Paso: Dominio público)
# GATEWAY_PUBLIC_URL=

# ===== OPTIONAL =====

# Nombre de la aplicación (mostrado en /setup y logs)
# Default: "Objetiva Sync Gateway"
APP_NAME=Objetiva Sync Gateway

# Lista de entidades para sincronizar (comma-separated)
# Si está vacío o no se define, se usan todas las entidades por defecto
# Ejemplo: SYNC_ENTITIES=articulos,comprobantes_cabecera,comprobantes_detalle
# Default: todas las entidades configuradas en src/config/entities.ts
SYNC_ENTITIES=

# ===== CODEGEN ONLY (not used in runtime) =====
# These variables are only used by scripts/regenerate-schemas.ts

# URL del gateway para regenerar schemas (opcional, solo para desarrollo)
# GATEWAY_URL=http://localhost:3335

# Password en texto plano para codegen (NO USAR EN PRODUCCIÓN)
# Solo necesario si ejecutas npm run regenerate-schemas
# SYNC_PASSWORD=your-plain-password-here
